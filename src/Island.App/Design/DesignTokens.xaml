<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- SPACING SCALE (4, 8, 12, 16, 24) -->
    <sys:Double x:Key="Space.Xs">4</sys:Double>
    <sys:Double x:Key="Space.Sm">8</sys:Double>
    <sys:Double x:Key="Space.Md">12</sys:Double>
    <sys:Double x:Key="Space.Lg">16</sys:Double>
    <sys:Double x:Key="Space.Xl">24</sys:Double>

    <!-- UNIFIED SPACING GAP TOKENS (Group gap 16/20, Item gap 8, Inline gap 6) -->
    <sys:Double x:Key="Spacing.Group">16</sys:Double>
    <sys:Double x:Key="Spacing.GroupWide">20</sys:Double>
    <sys:Double x:Key="Spacing.Item">8</sys:Double>
    <sys:Double x:Key="Spacing.Inline">6</sys:Double>

    <!-- DIVIDER TOKENS (1px 6% white) -->
    <SolidColorBrush x:Key="Divider.Brush" Color="#0FFFFFFF"/>
    <sys:Double x:Key="Divider.Height">1</sys:Double>

    <!-- LIST ROW HOVER TOKENS (Hover-only 5% white, radius 10, fixed row height) -->
    <SolidColorBrush x:Key="Row.Hover.Background" Color="#0DFFFFFF"/>
    <CornerRadius x:Key="Row.Hover.Radius">10</CornerRadius>
    <Thickness x:Key="Row.Padding">8,6,8,6</Thickness>

    <!-- INTERACTIVE CONTROL TOKENS (Quick Controls Tiles) -->
    <CornerRadius x:Key="Radius.Tile">14</CornerRadius>
    <Thickness x:Key="Padding.Tile">10</Thickness>

    <!-- SINGLE ROOT PADDING OWNER (16 DIP left/right, 14 DIP top/bottom) -->
    <Thickness x:Key="Padding.Island">16,14,16,14</Thickness>
    <sys:Double x:Key="Island.WallInset">30</sys:Double>
    <sys:Double x:Key="Island.HorizontalInset">60</sys:Double>
    <Thickness x:Key="Padding.Card">0</Thickness>
    <Thickness x:Key="Padding.Page">0</Thickness>
    <Thickness x:Key="Margin.Card">0</Thickness>
    <Thickness x:Key="Margin.Row">0</Thickness>
    <sys:Double x:Key="Height.Header">44</sys:Double>

    <!-- CORNER RADII (Card 16, Control 12, Pill 999, Chip 6) -->
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Control">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">6</CornerRadius>
    <CornerRadius x:Key="Radius.Mini">4</CornerRadius>

    <!-- FONT SIZES -->
    <sys:Double x:Key="FontSize.Label">12.5</sys:Double>
    <sys:Double x:Key="FontSize.Secondary">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.SectionTitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Value">17</sys:Double>
    <sys:Double x:Key="FontSize.HeaderTime">20</sys:Double>
    <sys:Double x:Key="FontSize.Hero">32</sys:Double>
    <sys:Double x:Key="FontSize.HeroLarge">56</sys:Double>

    <!-- Font Size & Family Aliases -->
    <sys:Double x:Key="Font.Label">12.5</sys:Double>
    <sys:Double x:Key="Font.Secondary">13</sys:Double>
    <sys:Double x:Key="Font.Body">14</sys:Double>
    <sys:Double x:Key="Font.Title">16</sys:Double>
    <sys:Double x:Key="Font.SectionTitle">16</sys:Double>
    <sys:Double x:Key="Font.Value">17</sys:Double>
    <sys:Double x:Key="Font.HeaderTime">20</sys:Double>
    <sys:Double x:Key="Font.HeaderDate">13</sys:Double>
    <sys:Double x:Key="Font.CollapsedClock">16</sys:Double>
    <sys:Double x:Key="Font.Hero">32</sys:Double>
    <sys:Double x:Key="Font.HeroLarge">56</sys:Double>
    <FontFamily x:Key="Font.FamilyDisplay">pack://application:,,,/Fonts/#Orbitron, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.FamilyMono">Cascadia Code, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Font.FamilyText">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- TYPOGRAPHY 5-ROLE SYSTEM TOKENS -->
    <FontFamily x:Key="Typography.Family.Display">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Typography.Family.Heading">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Typography.Family.Body">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Typography.Family.Label">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Typography.Family.Numeric">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>

    <FontWeight x:Key="Typography.Weight.Display">Bold</FontWeight>
    <FontWeight x:Key="Typography.Weight.Heading">SemiBold</FontWeight>
    <FontWeight x:Key="Typography.Weight.Body">Normal</FontWeight>
    <FontWeight x:Key="Typography.Weight.Label">Normal</FontWeight>
    <FontWeight x:Key="Typography.Weight.Numeric">SemiBold</FontWeight>

    <sys:Double x:Key="Typography.Size.HeroLarge">56</sys:Double>
    <sys:Double x:Key="Typography.Size.Hero">32</sys:Double>
    <sys:Double x:Key="Typography.Size.HeaderTime">20</sys:Double>
    <sys:Double x:Key="Typography.Size.SectionTitle">16</sys:Double>
    <sys:Double x:Key="Typography.Size.Value">17</sys:Double>
    <sys:Double x:Key="Typography.Size.Body">14</sys:Double>
    <sys:Double x:Key="Typography.Size.Secondary">13</sys:Double>
    <sys:Double x:Key="Typography.Size.Label">12.5</sys:Double>
    <sys:Double x:Key="Typography.Size.Mini">11</sys:Double>

    <sys:Boolean x:Key="Typography.UppercaseLabels">False</sys:Boolean>
    <sys:Boolean x:Key="Typography.TabularNumerals">True</sys:Boolean>

    <!-- TOUCH / CLICK TARGETS -->
    <sys:Double x:Key="Target.MinSize">36</sys:Double>
    <sys:Double x:Key="Target.IconSize">20</sys:Double>

    <!-- FONT FAMILIES -->
    <FontFamily x:Key="Font.Display">pack://application:,,,/Fonts/#Orbitron, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji</FontFamily>

    <!-- FLAT LIST ROW STYLE (Hover-only 5% white, radius 10, fixed row height) -->
    <Style x:Key="FlatListRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Row.Hover.Radius}"/>
        <Setter Property="Padding" Value="{StaticResource Row.Padding}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Row.Hover.Background}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- FLAT 1PX DIVIDER (6% white) -->
    <Style x:Key="FlatDivider" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Divider.Height}"/>
        <Setter Property="Background" Value="{StaticResource Divider.Brush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- INTERACTIVE CONTROL TILE (Quick Controls Tiles: Fill, radius 14, padding 10) -->
    <Style x:Key="QuickControlsTile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardRestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Tile}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- CARD STYLE (Subtle fill, 1px top highlight, outline only on hover/focus) -->
    <Style x:Key="IslandCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardRestBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="12"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- PILL BUTTON STYLE -->
    <Style x:Key="IslandPillButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Secondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PillBorder" CornerRadius="{StaticResource Radius.Pill}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource Theme.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PillBorder" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ICON BUTTON STYLE -->
    <Style x:Key="IslandIconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Target.MinSize}"/>
        <Setter Property="Height" Value="{StaticResource Target.MinSize}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="IconBox" CornerRadius="{StaticResource Radius.Control}"
                            Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconBox" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="IconBox" Property="Background" Value="{DynamicResource Theme.BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- METRIC PROGRESS BAR (Cyan Data) -->
    <Style x:Key="IslandProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="3" Background="{DynamicResource Theme.Border}">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource Theme.Data}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SMOOTH SLIDER -->
    <Style x:Key="IslandFullSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="32" Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Theme.Data}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="{DynamicResource Theme.Data}" Width="16" Height="16"/>
                                                <Ellipse Fill="#FFFFFF" Width="10" Height="10"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Theme.BorderStrong}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MODERN THIN OVERLAY SCROLLBAR (4-6 DIP width, rounded pill thumb, transparent track) -->
    <Style x:Key="IslandScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            CornerRadius="2.5"
                            Background="{DynamicResource Theme.BorderStrong}"
                            Opacity="0.45"
                            Margin="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.85"/>
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Theme.TextSecondary}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" SnapsToDevicePixels="True" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource IslandScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="5"/>
                <Setter Property="MinWidth" Value="5"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="5"/>
                <Setter Property="MinHeight" Value="5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="OverridesDefaultStyle" Value="False"/>
        <Setter Property="PanningMode" Value="Both"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

</ResourceDictionary>
