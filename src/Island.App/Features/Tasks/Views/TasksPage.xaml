<UserControl x:Class="Island.App.Features.Tasks.Views.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Theme.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="FilterSegmentBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="6" Background="{DynamicResource Theme.SurfaceHover}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.BorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskRowActionBtn" TargetType="Button">
            <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="4" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Input & Filter Bar (Interactive Control) -->
        <Border Grid.Row="0" Style="{StaticResource IslandCard}" Padding="10,6" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <!-- Filters on the Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="{Binding AllFilterText}" Click="FilterAllClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterSegmentBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllFilter}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding ActiveFilterText}" Click="FilterActiveClick" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterSegmentBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActiveFilter}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding DoneFilterText}" Click="FilterDoneClick" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterSegmentBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDoneFilter}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Priority Chip -->
                <Button DockPanel.Dock="Right" Style="{StaticResource FilterSegmentBtn}"
                        Content="{Binding NewTaskPriorityText}" Foreground="{Binding NewTaskPriorityBrush}"
                        Margin="6,0,0,0" ToolTip="Priority: Click to cycle (Low / Med / High)" Click="CyclePriorityClick"/>

                <!-- Add Button -->
                <Button DockPanel.Dock="Right" Style="{StaticResource IslandIconButton}" Width="28" Height="28"
                        Content="&#xE710;" Margin="4,0,0,0" Click="AddTaskClick" ToolTip="Add Task (Enter)"/>

                <!-- Input Field -->
                <Grid VerticalAlignment="Center" Margin="4,0,6,0">
                    <TextBlock Text="Add a task... (Press Enter to save)" Foreground="{DynamicResource Theme.TextTertiary}"
                               FontSize="{StaticResource FontSize.Body}" IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInput}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="TaskInput" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Theme.TextPrimary}" CaretBrush="{DynamicResource Theme.Accent}"
                             FontSize="{StaticResource FontSize.Body}" VerticalAlignment="Center"
                             PreviewMouseLeftButtonDown="TaskInputPreviewMouseDown"
                             KeyDown="TaskInputKeyDown" GotFocus="TaskInputGotFocus" LostFocus="TaskInputLostFocus"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Tasks Content Area -->
        <Grid Grid.Row="1">
            <!-- Compact 1-line Empty State -->
            <Border Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"
                    Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource Font.Icons}"
                               FontSize="14" Foreground="{DynamicResource Theme.TextTertiary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="No tasks here. Add one above!" FontSize="{StaticResource FontSize.Secondary}"
                               Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Tasks Items List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="320"
                          Visibility="{Binding HasFilteredTasks, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding FilteredTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TaskCard" Style="{StaticResource FlatListRow}">
                                <DockPanel LastChildFill="True">
                                    <!-- Priority Dot Left -->
                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding PriorityBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding PriorityText}"/>

                                    <!-- Custom Checkbox Left -->
                                    <Button DockPanel.Dock="Left" Width="20" Height="20" Background="Transparent"
                                            BorderThickness="0" Focusable="False" Cursor="Hand" Margin="0,0,10,0"
                                            Tag="{Binding Id}" Click="ToggleClick">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                                        BorderBrush="{DynamicResource Theme.BorderStrong}" Background="Transparent">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" FontSize="11"
                                                               Foreground="#0A0E14" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsCompleted, Converter={StaticResource Visible}}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Action Buttons Right (Hover-revealed) -->
                                    <StackPanel x:Name="ActionPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center" Opacity="0">
                                        <Button Style="{StaticResource TaskRowActionBtn}" Content="&#xE74A;"
                                                Tag="{Binding Id}" Click="MoveUpClick" ToolTip="Move Up"/>
                                        <Button Style="{StaticResource TaskRowActionBtn}" Content="&#xE74B;"
                                                Tag="{Binding Id}" Click="MoveDownClick" ToolTip="Move Down"/>
                                        <Button Style="{StaticResource TaskRowActionBtn}" Content="&#xE74D;"
                                                Tag="{Binding Id}" Click="DeleteClick" ToolTip="Delete Task" Margin="2,0,0,0"/>
                                    </StackPanel>

                                    <!-- Due Date Chip & Reminder Right -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0">
                                        <!-- Reminder Bell -->
                                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xEA8F;" FontSize="11"
                                                   Foreground="{DynamicResource Theme.Accent}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasReminder, Converter={StaticResource Visible}}"/>

                                        <!-- Due Date Chip -->
                                        <Border CornerRadius="4" Background="{DynamicResource Theme.SurfaceHover}" Padding="6,2"
                                                Visibility="{Binding DueText, Converter={StaticResource Visible}}">
                                            <TextBlock Text="{Binding DueText}" FontSize="{StaticResource FontSize.Label}"
                                                       Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Task Title Center -->
                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize.Body}"
                                               Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ActionPanel" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
