<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="Visible"/>

    <Style x:Key="MiniCoreBar" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Border}"/>
    </Style>

    <Style x:Key="SegmentSortBtn" TargetType="Button">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Label}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Typography.Family.Label}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="6" Background="{DynamicResource Theme.SurfaceHover}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.BorderStrong}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="DriveItemTemplate">
        <Grid Margin="0,2" ToolTip="{Binding Tooltip}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                           FontFamily="{DynamicResource Typography.Family.Heading}"
                           FontSize="{DynamicResource Typography.Size.Label}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextSecondary}"/>
                <TextBlock Grid.Column="1" Text="{Binding UsageText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}"
                           FontFamily="{DynamicResource Typography.Family.Numeric}"
                           FontSize="{DynamicResource Typography.Size.Label}"
                           Foreground="{DynamicResource Theme.TextSecondary}" Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <ProgressBar Grid.Row="2" Style="{StaticResource IslandProgressBar}" Height="4" Value="{Binding Percent, Mode=OneWay}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
