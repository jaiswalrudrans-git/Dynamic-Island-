<UserControl x:Class="Island.App.Features.Clipboard.Views.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Island.App.Features.Clipboard.Views"
             Focusable="False" Foreground="{DynamicResource Theme.TextPrimary}">
    <UserControl.Resources>
        <local:BoolToVisConverter x:Key="Vis"/>
        <local:BoolToVisConverter x:Key="Invis" Invert="True"/>

        <!-- Tooltip Style using Body Font -->
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{DynamicResource Typography.Family.Body}"/>
            <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Label}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Mini Icon Button (Font.Icons ONLY for Content glyphs) -->
        <Style x:Key="MiniIconBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="4" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row Action Button (Hover Actions) -->
        <Style x:Key="RowActionBtn" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="4" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Input Box -->
        <Style x:Key="SearchInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Label}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Typography.Family.Body}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Link Button (Clear link, etc.) -->
        <Style x:Key="TextLinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Typography.Family.Body}"/>
            <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Label}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <!-- COMPACT EMPTY STATE (Both Halves Empty ~96 DIP) -->
        <Grid Visibility="{Binding BothEmpty, Converter={StaticResource Vis}}" Height="96">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Font.Icons}"
                           FontSize="22" Foreground="{DynamicResource Theme.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Clipboard is empty" FontFamily="{DynamicResource Typography.Family.Heading}"
                           FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextSecondary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Copied text, images, and dropped files will appear here."
                           FontFamily="{DynamicResource Typography.Family.Body}"
                           FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- DUAL-HALF LAYOUT (When at least one half has items) -->
        <Grid Visibility="{Binding BothEmpty, Converter={StaticResource Invis}}">
            <Grid.ColumnDefinitions>
                <!-- Left Half: Clipboard -->
                <ColumnDefinition Width="*"/>
                <!-- Divider (1px 6% white) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Right Half: File Transfer -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT HALF: Clipboard -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Left Header Strip: Title, All/Favorites tabs, Search, Pause, Clear -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Column="0" Text="Clipboard" FontFamily="{DynamicResource Typography.Family.Heading}"
                               FontSize="{DynamicResource Typography.Size.SectionTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>

                    <!-- Underline Tabs: All / Favorites -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <!-- All Tab -->
                        <Button Click="AllTabClick" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="AllLbl" Text="All" FontFamily="{DynamicResource Typography.Family.Body}"
                                                   FontSize="{DynamicResource Typography.Size.Label}"
                                                   Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold"/>
                                        <Rectangle x:Name="AllUnderline" Height="2" Margin="0,2,0,0" Fill="{DynamicResource Theme.Accent}"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                            <Setter TargetName="AllLbl" Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
                                            <Setter TargetName="AllLbl" Property="FontWeight" Value="Normal"/>
                                            <Setter TargetName="AllUnderline" Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Favorites Tab -->
                        <Button Click="FavoritesTabClick" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" Margin="6,0,0,0" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="FavLbl" Text="Favorites" FontFamily="{DynamicResource Typography.Family.Body}"
                                                   FontSize="{DynamicResource Typography.Size.Label}"
                                                   Foreground="{DynamicResource Theme.TextSecondary}" FontWeight="Normal"/>
                                        <Rectangle x:Name="FavUnderline" Height="2" Margin="0,2,0,0" Fill="{DynamicResource Theme.Accent}" Visibility="Hidden"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                            <Setter TargetName="FavLbl" Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                                            <Setter TargetName="FavLbl" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="FavUnderline" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Action Controls: Search / Pause / Clear -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MiniIconBtn}" Content="&#xE721;" Click="ToggleSearchClick" ToolTip="Search copies"/>
                        <Button Content="{Binding PauseGlyph}" Click="TogglePauseClick"
                                ToolTip="{Binding PauseStatusText}" Margin="2,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MiniIconBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource MiniIconBtn}" Content="&#xE74D;" Click="ClearAllClick"
                                ToolTip="Clear unpinned copies" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Search Input Row (collapsible) -->
                <Grid Grid.Row="1" Margin="0,0,0,6" Visibility="{Binding IsSearchOpen, Converter={StaticResource Vis}}">
                    <TextBox Style="{StaticResource SearchInputBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             GotFocus="SearchGotFocus" LostFocus="SearchLostFocus"
                             ToolTip="Search text, applications, or files"/>
                </Grid>

                <!-- Clipboard Items List (up to 5 rows visible, 160 DIP) -->
                <Grid Grid.Row="2">
                    <!-- Empty line when list is empty -->
                    <Border Height="80" Visibility="{Binding HasClipboardItems, Converter={StaticResource Invis}}">
                        <TextBlock Text="Nothing copied yet"
                                   FontFamily="{DynamicResource Typography.Family.Body}"
                                   FontSize="{DynamicResource Typography.Size.Label}"
                                   Foreground="{DynamicResource Theme.TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Scrollable Row List -->
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" Visibility="{Binding HasClipboardItems, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding DisplayedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="32" CornerRadius="4" Cursor="Hand"
                                            Background="Transparent"
                                            MouseLeftButtonDown="Row_Click"
                                            MouseMove="Row_MouseMove"
                                            MouseEnter="Row_MouseEnter"
                                            MouseLeave="Row_MouseLeave"
                                            ToolTip="{Binding DisplayLabel}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 28 DIP Thumbnail or Icon -->
                                            <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                                <Border CornerRadius="4" Background="{DynamicResource Theme.SurfaceRaised}">
                                                    <TextBlock Text="{Binding TypeGlyph}"
                                                               FontFamily="{StaticResource Font.Icons}"
                                                               FontSize="12" Foreground="{DynamicResource Theme.Accent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border CornerRadius="4" ClipToBounds="True"
                                                        Visibility="{Binding IsImage, Converter={StaticResource Vis}}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                </Border>
                                            </Grid>

                                            <!-- Content Label -->
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}"
                                                       FontFamily="{DynamicResource Typography.Family.Body}"
                                                       FontSize="{DynamicResource Typography.Size.Label}"
                                                       Foreground="{DynamicResource Theme.TextPrimary}"
                                                       VerticalAlignment="Center" Margin="8,0,4,0"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Time / Hover Actions -->
                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TimeLabel" Text="{Binding RelativeTime}"
                                                           FontFamily="{DynamicResource Typography.Family.Body}"
                                                           FontSize="{DynamicResource Typography.Size.Mini}"
                                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                                           VerticalAlignment="Center"/>

                                                <StackPanel x:Name="HoverActions" Orientation="Horizontal" Visibility="Collapsed">
                                                    <Button Style="{StaticResource RowActionBtn}" Content="{Binding PinGlyph}"
                                                            Click="RowFavoriteClick" ToolTip="Favorite"/>
                                                    <Button Style="{StaticResource RowActionBtn}" Content="&#xE8C8;"
                                                            Click="RowCopyClick" ToolTip="Copy"/>
                                                    <Button Style="{StaticResource RowActionBtn}" Content="&#xE8D2;"
                                                            Click="RowPastePlainClick" ToolTip="Paste as plain text"/>
                                                    <Button Style="{StaticResource RowActionBtn}" Content="&#xE74D;"
                                                            Click="RowDeleteClick" ToolTip="Delete"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TimeLabel" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="HoverActions" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- THIN DIVIDER (1px 6% white) -->
            <Rectangle Grid.Column="1" Width="1" Fill="#0Fffffff" Margin="10,0"/>

            <!-- RIGHT HALF: File Transfer Drop Shelf -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: Title and Clear link -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="File transfer" FontFamily="{DynamicResource Typography.Family.Heading}"
                               FontSize="{DynamicResource Typography.Size.SectionTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Style="{StaticResource TextLinkBtn}" Content="Clear"
                            Click="ClearFilesClick"
                            Visibility="{Binding HasDroppedFiles, Converter={StaticResource Vis}}"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Drop Shelf Area -->
                <Border Grid.Row="1" AllowDrop="True"
                        Drop="DropShelf_Drop" DragOver="DropShelf_DragOver" DragEnter="DropShelf_DragEnter"
                        Background="{DynamicResource Theme.SurfaceRaised}" CornerRadius="6"
                        BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                        MinHeight="120">
                    <Grid>
                        <!-- Empty Shelf: Stacked cards icon and "Drag files here" -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasDroppedFiles, Converter={StaticResource Invis}}">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Font.Icons}"
                                       FontSize="22" Foreground="{DynamicResource Theme.TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Drag files here" FontFamily="{DynamicResource Typography.Family.Body}"
                                       FontSize="{DynamicResource Typography.Size.Label}"
                                       Foreground="{DynamicResource Theme.TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Dropped File Chips List -->
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False" Margin="4"
                                      Visibility="{Binding HasDroppedFiles, Converter={StaticResource Vis}}">
                            <ItemsControl ItemsSource="{Binding DroppedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="28" Margin="0,1" CornerRadius="4"
                                                Background="{DynamicResource Theme.Background}"
                                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                                MouseMove="FileChip_MouseMove" Cursor="Hand" ToolTip="{Binding FullPath}">
                                            <Grid Margin="6,0,4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- File Type Icon -->
                                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}"
                                                           FontFamily="{StaticResource Font.Icons}"
                                                           FontSize="11" Foreground="{DynamicResource Theme.Accent}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                <!-- File Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                           FontFamily="{DynamicResource Typography.Family.Body}"
                                                           FontSize="{DynamicResource Typography.Size.Label}"
                                                           Foreground="{DynamicResource Theme.TextPrimary}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                <!-- File Size -->
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                           FontFamily="{DynamicResource Typography.Family.Body}"
                                                           FontSize="{DynamicResource Typography.Size.Mini}"
                                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                                           VerticalAlignment="Center" Margin="6,0,6,0"/>

                                                <!-- Remove Button -->
                                                <Button Grid.Column="3" Style="{StaticResource RowActionBtn}" Content="&#xE711;"
                                                        Click="RemoveFileClick" ToolTip="Remove"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Hover Image Large Preview Popup -->
        <Popup x:Name="ImagePreviewPopup" AllowsTransparency="True" IsOpen="False" Placement="Right"
               HorizontalOffset="12" VerticalOffset="0" StaysOpen="False">
            <Border Background="{DynamicResource Theme.Background}" BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="6" MaxWidth="320" MaxHeight="240">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.35"/>
                </Border.Effect>
                <Image x:Name="PreviewPopupImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
