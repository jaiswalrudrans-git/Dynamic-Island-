<Window x:Class="Island.App.Views.MotionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Background}" Foreground="{DynamicResource Theme.Foreground}">
    <StackPanel Margin="24">
        <TextBlock Text="Motion" FontSize="24" FontWeight="SemiBold"/>
        <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource Theme.Surface}" CornerRadius="12">
            <StackPanel>
                <CheckBox x:Name="Reduced" Content="Reduce motion" Foreground="{DynamicResource Theme.Foreground}"/>
                <DockPanel Margin="0,18,0,4"><TextBlock Text="Animation speed"/><TextBlock Text="{Binding Value, ElementName=Speed, StringFormat={}{0:0.##}×}" HorizontalAlignment="Right"/></DockPanel>
                <Slider x:Name="Speed" Minimum="0.5" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True"/>
                <DockPanel Margin="0,14,0,4"><TextBlock Text="Hover delay"/><TextBlock Text="{Binding Value, ElementName=Hover, StringFormat={}{0:0} ms}" HorizontalAlignment="Right"/></DockPanel>
                <Slider x:Name="Hover" Minimum="0" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True"/>
                <DockPanel Margin="0,14,0,4"><TextBlock Text="Collapse delay"/><TextBlock Text="{Binding Value, ElementName=Leave, StringFormat={}{0:0} ms}" HorizontalAlignment="Right"/></DockPanel>
                <Slider x:Name="Leave" Minimum="0" Maximum="5000" TickFrequency="10" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
