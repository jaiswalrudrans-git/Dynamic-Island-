<Window x:Class="Island.App.Views.MotionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Island.App.Views"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Background}" Foreground="{DynamicResource Theme.Foreground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
        <StackPanel Margin="24">
            <!-- Appearance Section -->
            <TextBlock Text="Appearance" FontSize="24" FontWeight="SemiBold"/>
            <Border Margin="0,14,0,0" Padding="16" Background="{DynamicResource Theme.Surface}" CornerRadius="12">
                <StackPanel>
                    <DockPanel Margin="0,2,0,8">
                        <TextBlock Text="Theme" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeSelector" HorizontalAlignment="Right" MinWidth="130"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,8">
                        <TextBlock Text="Surface style" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SurfaceSelector" HorizontalAlignment="Right" MinWidth="130"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,2">
                        <TextBlock Text="Background transparency" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="{DynamicResource Theme.SurfaceRaised}"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6"
                                Padding="4,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="BgTranspBox" Width="28" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource Theme.Foreground}" TextAlignment="Right"
                                         VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="%" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11"
                                           VerticalAlignment="Center" Margin="1,0,5,0"/>
                                <Border Width="1" Height="14" Background="{DynamicResource Theme.Border}" VerticalAlignment="Center"/>
                                <Button x:Name="BgTranspMinus" Content="−" Width="20" Height="20" Margin="3,0,1,0"
                                        Padding="0" Background="Transparent" Foreground="{DynamicResource Theme.Foreground}"
                                        BorderThickness="0" Cursor="Hand" FontWeight="Bold" VerticalContentAlignment="Center"/>
                                <Button x:Name="BgTranspPlus" Content="+" Width="20" Height="20" Margin="1,0,2,0"
                                        Padding="0" Background="Transparent" Foreground="{DynamicResource Theme.Foreground}"
                                        BorderThickness="0" Cursor="Hand" FontWeight="Bold" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <Slider x:Name="BgTranspSlider" Minimum="0" Maximum="70" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,2,0,2">
                        <TextBlock Text="Collapsed notch transparency" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="{DynamicResource Theme.SurfaceRaised}"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6"
                                Padding="4,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="ColTranspBox" Width="28" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource Theme.Foreground}" TextAlignment="Right"
                                         VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="%" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11"
                                           VerticalAlignment="Center" Margin="1,0,5,0"/>
                                <Border Width="1" Height="14" Background="{DynamicResource Theme.Border}" VerticalAlignment="Center"/>
                                <Button x:Name="ColTranspMinus" Content="−" Width="20" Height="20" Margin="3,0,1,0"
                                        Padding="0" Background="Transparent" Foreground="{DynamicResource Theme.Foreground}"
                                        BorderThickness="0" Cursor="Hand" FontWeight="Bold" VerticalContentAlignment="Center"/>
                                <Button x:Name="ColTranspPlus" Content="+" Width="20" Height="20" Margin="1,0,2,0"
                                        Padding="0" Background="Transparent" Foreground="{DynamicResource Theme.Foreground}"
                                        BorderThickness="0" Cursor="Hand" FontWeight="Bold" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <Slider x:Name="ColTranspSlider" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,4,0,8">
                        <TextBlock Text="Interface size" VerticalAlignment="Center"/>
                        <ComboBox x:Name="InterfaceSizeSelector" HorizontalAlignment="Right" MinWidth="130"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,4">
                        <TextBlock Text="Fine UI scale"/>
                        <TextBlock Text="{Binding Value, ElementName=UiScaleSlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="UiScaleSlider" Minimum="0.9" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                    <!-- Neon Intensity -->
                    <DockPanel Margin="0,4,0,2">
                        <TextBlock Text="Neon intensity" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="{DynamicResource Theme.SurfaceRaised}"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6"
                                Padding="4,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="NeonIntensityBox" Width="28" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource Theme.Foreground}" TextAlignment="Right"
                                         VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="%" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11"
                                           VerticalAlignment="Center" Margin="1,0,5,0"/>
                                <Border Width="1" Height="14" Background="{DynamicResource Theme.Border}" VerticalAlignment="Center"/>
                                <Button x:Name="NeonIntensityMinus" Content="−" Width="20" Height="20" Margin="3,0,1,0"
                                        Padding="0" Background="Transparent" Foreground="{DynamicResource Theme.Foreground}"
                                        BorderThickness="0" Cursor="Hand" FontWeight="Bold" VerticalContentAlignment="Center"/>
                                <Button x:Name="NeonIntensityPlus" Content="+" Width="20" Height="20" Margin="1,0,2,0"
                                        Padding="0" Background="Transparent" Foreground="{DynamicResource Theme.Foreground}"
                                        BorderThickness="0" Cursor="Hand" FontWeight="Bold" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <Slider x:Name="NeonIntensitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                    <!-- Bottom Neon Line Toggles -->
                    <CheckBox x:Name="BottomNeonLineCheck" Content="Bottom-edge neon line" Foreground="{DynamicResource Theme.Foreground}" Margin="0,4,0,6"/>
                    <CheckBox x:Name="NeonMusicReactiveCheck" Content="Music-reactive pulse while playing" Foreground="{DynamicResource Theme.Foreground}" Margin="18,0,0,6"/>
                    <CheckBox x:Name="NeonLoadReactiveCheck" Content="Shift to yellow/red warning on high load or temp" Foreground="{DynamicResource Theme.Foreground}" Margin="18,0,0,4"/>
                </StackPanel>
            </Border>

            <!-- Clock Studio Section -->
            <TextBlock Text="Clock Studio" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Border Margin="0,14,0,0" Padding="16" Background="{DynamicResource Theme.Surface}" CornerRadius="12">
                <StackPanel>
                    <CheckBox x:Name="ShowNotchClockCheck" Content="Show clock in collapsed notch" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,12"/>

                    <!-- Heading -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Clock style" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock x:Name="CurrentStyleLabel" Text="Simple" Foreground="{DynamicResource Theme.Accent}" HorizontalAlignment="Right" FontSize="12"/>
                    </DockPanel>

                    <!-- Style Preview Tiles Grid (Live Time) -->
                    <UniformGrid x:Name="ClockStylesGrid" Columns="3" Margin="-4,0,-4,8"/>

                    <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,8,0,12"/>

                    <!-- Clock Color Row -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Clock color" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock x:Name="CurrentColorLabel" Text="White" Foreground="{DynamicResource Theme.Accent}" HorizontalAlignment="Right" FontSize="12"/>
                    </DockPanel>
                    <WrapPanel x:Name="ColorSwatchesPanel" Margin="0,0,0,8"/>

                    <!-- Custom Color Input Row (shown when Custom is selected) -->
                    <DockPanel x:Name="CustomColorRow" Margin="0,4,0,8" Visibility="Collapsed">
                        <TextBlock Text="Custom hex color" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <TextBox x:Name="CustomColorBox" Width="90" HorizontalAlignment="Right" Background="{DynamicResource Theme.SurfaceRaised}"
                                 Foreground="{DynamicResource Theme.Foreground}" BorderBrush="{DynamicResource Theme.Border}"
                                 BorderThickness="1" Padding="4,2" TextAlignment="Center"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,8,0,12"/>

                    <!-- Options -->
                    <CheckBox x:Name="Clock24HourCheck" Content="24-hour clock" Foreground="{DynamicResource Theme.Foreground}" Margin="0,2,0,6"/>
                    <CheckBox x:Name="ClockSecondsCheck" Content="Show seconds" Foreground="{DynamicResource Theme.Foreground}" Margin="0,2,0,6"/>
                    <CheckBox x:Name="ClockBlinkCheck" Content="Blinking colon" Foreground="{DynamicResource Theme.Foreground}" Margin="0,2,0,6"/>
                    <CheckBox x:Name="ClockZeroCheck" Content="Leading zero" Foreground="{DynamicResource Theme.Foreground}" Margin="0,2,0,8"/>

                    <DockPanel Margin="0,6,0,4">
                        <TextBlock Text="Clock size" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Value, ElementName=ClockSizeSlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="ClockSizeSlider" Minimum="0.8" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </Border>

            <!-- Typography Studio Section -->
            <TextBlock Text="Typography Studio" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Border Margin="0,14,0,0" Padding="16" Background="{DynamicResource Theme.Surface}" CornerRadius="12">
                <StackPanel>
                    <CheckBox x:Name="MatchTypographyCheck" Content="Match typography to clock style (automatic pairing)"
                              Foreground="{DynamicResource Theme.Foreground}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="MatchAccentCheck" Content="Match accent color to clock color"
                              Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,6"/>
                    <CheckBox x:Name="LegibilityGuardCheck" Content="Legibility guard (prevents unreadable small decorative text)"
                              Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,12"/>

                    <!-- Heading -->
                    <DockPanel Margin="0,4,0,8">
                        <TextBlock Text="Typography Theme" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock x:Name="CurrentTypographyLabel" Text="Classic" Foreground="{DynamicResource Theme.Accent}" HorizontalAlignment="Right" FontSize="12"/>
                    </DockPanel>

                    <!-- Typography Preset Tiles Grid -->
                    <UniformGrid x:Name="TypographyPresetsGrid" Columns="3" Margin="-4,0,-4,8"/>

                    <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,8,0,12"/>

                    <!-- Size Scale Slider (90% - 130%) -->
                    <DockPanel Margin="0,4,0,4">
                        <TextBlock Text="Font size scale" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock Text="{Binding Value, ElementName=TypographyScaleSlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{DynamicResource Theme.Accent}"/>
                    </DockPanel>
                    <Slider x:Name="TypographyScaleSlider" Minimum="0.9" Maximum="1.3" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

                    <!-- Weight Picker -->
                    <DockPanel Margin="0,4,0,8">
                        <TextBlock Text="Typography weight" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Foreground}"/>
                        <ComboBox x:Name="TypographyWeightCombo" HorizontalAlignment="Right" MinWidth="110"/>
                    </DockPanel>

                    <!-- Formatting Options -->
                    <CheckBox x:Name="TypographyUppercaseCheck" Content="Uppercase small labels" Foreground="{DynamicResource Theme.Foreground}" Margin="0,2,0,6"/>
                    <CheckBox x:Name="TypographyTabularCheck" Content="Tabular numeric figures" Foreground="{DynamicResource Theme.Foreground}" Margin="0,2,0,6"/>
                    <CheckBox x:Name="TypographyGlowCheck" Content="Text glow effect" Foreground="{DynamicResource Theme.Foreground}" Margin="0,2,0,4"/>

                    <!-- Glow Intensity -->
                    <DockPanel x:Name="TypographyGlowRow" Margin="18,4,0,10" Visibility="Collapsed">
                        <TextBlock Text="Glow intensity" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <Slider x:Name="TypographyGlowSlider" Minimum="0.1" Maximum="1.0" TickFrequency="0.05" Width="140" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,4,0,12"/>

                    <!-- Per-Role Font Overrides -->
                    <TextBlock Text="Per-Role Overrides" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,8"/>
                    
                    <DockPanel Margin="0,2,0,6">
                        <TextBlock Text="Display (Clock, Hero)" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <ComboBox x:Name="RoleDisplayCombo" HorizontalAlignment="Right" MinWidth="150"/>
                    </DockPanel>
                    <DockPanel Margin="0,2,0,6">
                        <TextBlock Text="Heading (Cards, Tabs)" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <ComboBox x:Name="RoleHeadingCombo" HorizontalAlignment="Right" MinWidth="150"/>
                    </DockPanel>
                    <DockPanel Margin="0,2,0,6">
                        <TextBlock Text="Body (Standard Text)" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <ComboBox x:Name="RoleBodyCombo" HorizontalAlignment="Right" MinWidth="150"/>
                    </DockPanel>
                    <DockPanel Margin="0,2,0,6">
                        <TextBlock Text="Label (Small Badges)" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <ComboBox x:Name="RoleLabelCombo" HorizontalAlignment="Right" MinWidth="150"/>
                    </DockPanel>
                    <DockPanel Margin="0,2,0,4">
                        <TextBlock Text="Numeric (Metrics, Stats)" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <ComboBox x:Name="RoleNumericCombo" HorizontalAlignment="Right" MinWidth="150"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Motion Section -->
            <TextBlock Text="Motion" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Border Margin="0,14,0,0" Padding="16" Background="{DynamicResource Theme.Surface}" CornerRadius="12">
                <StackPanel>
                    <CheckBox x:Name="Reduced" Content="Reduce motion" Foreground="{DynamicResource Theme.Foreground}"/>
                    <DockPanel Margin="0,18,0,4"><TextBlock Text="Animation speed"/><TextBlock Text="{Binding Value, ElementName=Speed, StringFormat={}{0:0.##}×}" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="Speed" Minimum="0.5" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True"/>
                    <DockPanel Margin="0,14,0,4"><TextBlock Text="Hover delay"/><TextBlock Text="{Binding Value, ElementName=Hover, StringFormat={}{0:0} ms}" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="Hover" Minimum="0" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True"/>
                    <DockPanel Margin="0,14,0,4"><TextBlock Text="Collapse delay"/><TextBlock Text="{Binding Value, ElementName=Leave, StringFormat={}{0:0} ms}" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="Leave" Minimum="0" Maximum="5000" TickFrequency="10" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </Border>

            <!-- Music Section -->
            <TextBlock Text="Music" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Border Margin="0,10,0,0" Padding="16" Background="{DynamicResource Theme.Surface}" CornerRadius="12">
                <StackPanel>
                    <StackPanel.Resources><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}"/><Setter Property="Margin" Value="0,2,0,4"/></Style></StackPanel.Resources>
                    <CheckBox x:Name="MusicPreview" Content="Show compact playback preview"/>
                    <DockPanel Margin="0,4,0,8"><TextBlock Text="Preview text" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PreviewText" HorizontalAlignment="Right" MinWidth="110"/></DockPanel>
                    <CheckBox x:Name="Equalizer" Content="Show output equalizer"/>
                    <CheckBox x:Name="Lyrics" Content="Look up synced lyrics on LRCLIB"/>
                    <CheckBox x:Name="CoverGlow" Content="Tint player with album artwork"/>
                </StackPanel>
            </Border>

            <!-- System & Notch Section -->
            <TextBlock Text="System &amp; Notch" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Border Margin="0,10,0,0" Padding="16" Background="{DynamicResource Theme.Surface}" CornerRadius="12">
                <StackPanel>
                    <DockPanel Margin="0,4,0,8"><TextBlock Text="Collapsed live stat" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CollapsedStat" HorizontalAlignment="Right" MinWidth="110"/></DockPanel>
                    <DockPanel Margin="0,4,0,0"><TextBlock Text="Top processes sort" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ProcessSort" HorizontalAlignment="Right" MinWidth="110"/></DockPanel>
                </StackPanel>
            </Border>

            <!-- Alerts & OSD Section -->
            <TextBlock Text="Alerts &amp; OSD" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Border Margin="0,10,0,0" Padding="16" Background="{DynamicResource Theme.Surface}" CornerRadius="12">
                <StackPanel>
                    <StackPanel.Resources><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}"/><Setter Property="Margin" Value="0,2,0,4"/></Style></StackPanel.Resources>
                    <CheckBox x:Name="AlertsEnabledCheck" Content="Enable collapsed alerts &amp; OSD"/>
                    <CheckBox x:Name="AlertVolumeCheck" Content="Volume &amp; mute OSD"/>
                    <CheckBox x:Name="AlertBrightnessCheck" Content="Brightness OSD"/>
                    <CheckBox x:Name="AlertMicCheck" Content="Microphone mute OSD"/>
                    <CheckBox x:Name="AlertBatteryCheck" Content="Battery &amp; charger alerts"/>
                    <CheckBox x:Name="AlertTempCheck" Content="Temperature warnings"/>
                    <CheckBox x:Name="AlertSoundCheck" Content="Play alert sound"/>
                    <DockPanel Margin="0,10,0,4"><TextBlock Text="Alert duration"/><TextBlock Text="{Binding Value, ElementName=AlertDurationSlider, StringFormat={}{0:0} s}" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="AlertDurationSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </Border>

            <!-- Developer & Diagnostics Section -->
            <TextBlock Text="Developer &amp; Diagnostics" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Border Margin="0,10,0,0" Padding="16" Background="{DynamicResource Theme.Surface}" CornerRadius="12">
                <StackPanel>
                    <StackPanel.Resources><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}"/><Setter Property="Margin" Value="0,2,0,4"/></Style></StackPanel.Resources>
                    <CheckBox x:Name="LayoutDebugCheck" Content="Layout debug overlay (show content bounds &amp; slack DIPs)"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
