<UserControl x:Class="Island.App.Views.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="{DynamicResource Theme.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <!-- Mini Action Button -->
        <Style x:Key="MiniActionBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="4" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji"
                                       FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Box Style -->
        <Style x:Key="SearchInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Secondary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Typography.Family.Body}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,4,12,10">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Action Bar (Count, Pause status, Clear All) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Optional Search Input -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Scrollable History Items List -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Strip -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Clipboard History" FontFamily="{DynamicResource Typography.Family.Heading}"
                           FontSize="{DynamicResource Typography.Size.SectionTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayedItems.Count, StringFormat=' ({0})'}"
                           FontFamily="{DynamicResource Typography.Family.Numeric}"
                           FontSize="{DynamicResource Typography.Size.Secondary}"
                           Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Pause / Resume -->
                <Button Click="TogglePauseClick" Cursor="Hand" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MiniActionBtn}">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="Content" Value="{Binding PauseStatusText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Warning}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Clear All -->
                <Button Style="{StaticResource MiniActionBtn}" Content="&#xE74D;" Click="ClearAllClick"
                        ToolTip="Clear unpinned history"/>
            </StackPanel>
        </Grid>

        <!-- ROW 1: Search Box (when > 8 items) -->
        <Grid Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding ShowSearchBox, Converter={StaticResource Visible}}">
            <TextBox Style="{StaticResource SearchInputBox}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     GotFocus="SearchGotFocus" LostFocus="SearchLostFocus"/>
        </Grid>

        <!-- ROW 2: Items List / Empty State -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="360" Focusable="False">
            <Grid>
                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24"
                            Visibility="{Binding DisplayedItems.Count, Converter={StaticResource Visible}}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayedItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji"
                               FontSize="32" Foreground="{DynamicResource Theme.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Clipboard history is empty" FontFamily="{DynamicResource Typography.Family.Heading}"
                               FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Copied text, images, and files will appear here."
                               FontFamily="{DynamicResource Typography.Family.Body}"
                               FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Items -->
                <ItemsControl ItemsSource="{Binding DisplayedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" CornerRadius="8" Background="{DynamicResource Theme.SurfaceRaised}"
                                    BorderBrush="{DynamicResource Theme.CardRestBorder}" BorderThickness="1"
                                    Padding="10,8" Cursor="Hand" MouseLeftButtonDown="ItemCardClick"
                                    MouseMove="ItemCardMouseMove" ToolTip="Click to paste (or copy)">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Type Icon -->
                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5"
                                            Background="{DynamicResource Theme.SurfaceHover}" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding TypeGlyph}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji"
                                                   FontSize="12" Foreground="{DynamicResource Theme.Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Content Column -->
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SourceAppName, TargetNullValue='Clipboard'}"
                                                       FontFamily="{DynamicResource Typography.Family.Label}"
                                                       FontSize="{DynamicResource Typography.Size.Label}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RelativeTime}"
                                                       FontFamily="{DynamicResource Typography.Family.Numeric}"
                                                       FontSize="{DynamicResource Typography.Size.Label}"
                                                       Foreground="{DynamicResource Theme.TextSecondary}" Typography.NumeralAlignment="Tabular"/>
                                        </Grid>

                                        <!-- Text Preview -->
                                        <TextBlock Text="{Binding PreviewText}" MaxHeight="36" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="{DynamicResource Typography.Family.Body}"
                                                   FontSize="{DynamicResource Typography.Size.Secondary}"
                                                   Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Pin -->
                                        <Button Style="{StaticResource MiniActionBtn}" Content="{Binding PinGlyph}"
                                                Click="ItemPinClick" Tag="{Binding Id}" ToolTip="Pin item"/>
                                        <!-- Copy -->
                                        <Button Style="{StaticResource MiniActionBtn}" Content="&#xE8C8;"
                                                Click="ItemCopyClick" Tag="{Binding Id}" ToolTip="Copy to clipboard"/>
                                        <!-- Delete -->
                                        <Button Style="{StaticResource MiniActionBtn}" Content="&#xE74D;"
                                                Click="ItemDeleteClick" Tag="{Binding Id}" ToolTip="Delete"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
