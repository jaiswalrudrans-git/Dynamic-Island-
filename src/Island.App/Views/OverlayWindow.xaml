<Window x:Class="Island.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Island.App.Views"
        Width="1040" Height="680" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Background="Transparent" AllowsTransparency="True"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlertProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2" Background="{DynamicResource Theme.Border}">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{DynamicResource Theme.Accent}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Reduced motion collapsed base -->
        <Grid x:Name="ReducedBase" Width="136" Height="35" HorizontalAlignment="Center" VerticalAlignment="Top"
              Visibility="Hidden" IsHitTestVisible="False">
            <Path Fill="{DynamicResource Theme.Surface}" Data="M0,0 H136 Q128,0 128,8 V18 Q128,35 110,35 H26 Q8,35 8,18 V8 Q8,0 0,0 Z"/>
            <local:ClockFace x:Name="ReducedClock" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Soft outer shadow matching notch silhouette -->
        <Path x:Name="OuterShadow" Fill="#80000000" IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35"/>
            </Path.Effect>
        </Path>

        <!-- Dynamic Island Shell -->
        <Grid x:Name="Shell" Background="Transparent" MouseEnter="EnterShell" MouseLeave="LeaveShell">
            <!-- Dynamic Island Background Surface (Themed surface across the whole notch geometry) -->
            <Border x:Name="CollapsedBackground" Background="{DynamicResource Theme.CollapsedSurface}"/>
            <Border x:Name="IslandBackground" Background="{DynamicResource Theme.Surface}" Opacity="0"/>

            <!-- 1 px inner stroke white at 8% so the shape stays defined over dark backdrops -->
            <Path x:Name="InnerRim" Stroke="{DynamicResource Theme.InnerRim}" StrokeThickness="2" IsHitTestVisible="False"/>

            <!-- Bottom neon reactive line -->
            <Border x:Name="BottomEdge" VerticalAlignment="Top" Height="1.5" Background="{DynamicResource Theme.NeonLine}" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform x:Name="EdgeOffset" Y="34"/></Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="BottomNeonGlow" Color="#FFFF2E97" BlurRadius="8" ShadowDepth="0" Opacity="0.75"/>
                </Border.Effect>
            </Border>

            <!-- Collapsed Notch Center Content -->
            <Grid Height="35" VerticalAlignment="Top">
                <!-- Compact Alert Pill -->
                <Grid x:Name="CompactAlert" Width="240" HorizontalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False">
                    <Grid.RenderTransform><TranslateTransform x:Name="AlertY"/></Grid.RenderTransform>
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding AlertGlyph}"
                                   FontSize="14" Foreground="{Binding AlertAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding AlertTitle}" FontFamily="Segoe UI" FontSize="{StaticResource Font.Label}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                        <ProgressBar Style="{StaticResource AlertProgressBar}" Value="{Binding AlertProgress, Mode=OneWay}"
                                     Width="48" Height="4" Margin="10,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding HasProgress, Converter={StaticResource Visible}}"/>
                    </DockPanel>
                </Grid>

                <!-- Compact Music Preview -->
                <Grid x:Name="CompactMusic" Width="220" HorizontalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False">
                    <Border Margin="-14,0" Opacity=".65">
                        <Border.Background>
                            <RadialGradientBrush Center=".13,.5" GradientOrigin=".13,.5" RadiusX=".6" RadiusY="1.5">
                                <GradientStop Color="{Binding Glow}" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Width="22" Height="22" HorizontalAlignment="Left">
                        <Border CornerRadius="5" Background="{DynamicResource Theme.SurfaceRaised}"/>
                        <TextBlock Text="&#xE8D6;" Foreground="{DynamicResource Theme.TextSecondary}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border CornerRadius="5"><Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Border.Background></Border>
                    </Grid>
                    <local:ScrollingLabel x:Name="PreviewLabel" Width="148" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <local:SpectrumMeter x:Name="CompactMeter" Width="25" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Compact Stat Preview -->
                <Grid x:Name="CompactStat" Width="210" HorizontalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time}" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center"/>
                        <Border Width="1" Height="10" Background="{DynamicResource Theme.Border}" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CollapsedStatGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="{DynamicResource Theme.Accent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CollapsedStatLabel}" FontFamily="Segoe UI" FontSize="{StaticResource Font.Label}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextSecondary}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Compact Focus Preview -->
                <Grid x:Name="CompactFocus" Width="210" HorizontalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE916;"
                                   FontSize="12" Foreground="{DynamicResource Theme.Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayTime}" FontFamily="Segoe UI" FontSize="{StaticResource Font.Secondary}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        <ProgressBar Style="{StaticResource AlertProgressBar}" Value="{Binding Progress, Mode=OneWay}"
                                     Width="42" Height="4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Default Collapsed Clock Face -->
                <local:ClockFace x:Name="CompactClock" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Expanded Island Header (Slimmer 44 DIP, tab icon bar, time 20px, date 12px, pin & settings) -->
            <Grid x:Name="Header" Height="44" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform><TranslateTransform x:Name="HeaderY"/></Grid.RenderTransform>

                <!-- Left: Tab Icon Bar with Selected Tab Gliding Indicator -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                        Background="{DynamicResource Theme.SurfaceRaised}" BorderBrush="{DynamicResource Theme.CardRestBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="2" ClipToBounds="True">
                    <Grid>
                        <Border x:Name="PillIndicator" Width="28" Height="28" HorizontalAlignment="Left"
                                Background="{DynamicResource Theme.Accent}" CornerRadius="4">
                            <Border.RenderTransform><TranslateTransform x:Name="PillX"/></Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="PillGlow" Color="#FFFF2E97" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                        <StackPanel x:Name="TabButtons" Orientation="Horizontal"/>
                    </Grid>
                </Border>

                <!-- Center: Clock & Date (TRUE DEAD CENTER of the entire Island) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <local:ClockFace x:Name="HeaderClock" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderDate" Text="{Binding Date}" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Right: Pin & Settings Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="PinClick" Content="&#xE718;"/>
                    <Button x:Name="GearButton" Style="{StaticResource IconButton}" Click="SettingsClick" Content="&#xE713;"
                            Margin="4,0,0,0" ToolTip="Settings" AutomationProperties.Name="Settings"/>
                </StackPanel>
            </Grid>

            <!-- Expanded Island Body: Content sits DIRECTLY on island surface (No double boxing!) -->
            <Border x:Name="Body" Margin="0,64,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Opacity="0" Background="Transparent" CornerRadius="0" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform x:Name="BodyY"/></Border.RenderTransform>
                <Grid x:Name="Pages" ClipToBounds="True"/>
            </Border>

            <!-- Dev-Only Layout Debug Overlay -->
            <Canvas x:Name="LayoutDebugOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle x:Name="DebugIslandBounds" Stroke="#00FF66" StrokeThickness="1" StrokeDashArray="3 3"/>
                <Rectangle x:Name="DebugHeaderBounds" Stroke="#00E5FF" StrokeThickness="1" StrokeDashArray="3 3"/>
                <Rectangle x:Name="DebugContentBounds" Stroke="#FF2E97" StrokeThickness="1" StrokeDashArray="3 3"/>
                <Border x:Name="DebugHud" Background="#EE080512" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="4" Padding="6,3">
                    <TextBlock x:Name="DebugHudText" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="#00FF66"/>
                </Border>
            </Canvas>
        </Grid>
    </Grid>
</Window>
