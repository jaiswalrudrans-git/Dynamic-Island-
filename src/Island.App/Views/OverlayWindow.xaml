<Window x:Class="Island.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Island.App.Views"
        Width="760" Height="400" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Background="Transparent" AllowsTransparency="True"
        Topmost="True" ShowActivated="False" Focusable="False" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="31"/><Setter Property="Height" Value="30"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#F1F4FA"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="9" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#22FFFFFF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#33FFFFFF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style x:Key="AlertProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2" Background="#26FFFFFF">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{DynamicResource Theme.Accent}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="ReducedBase" Width="130" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"
              Visibility="Hidden" IsHitTestVisible="False">
            <Path Fill="Black" Data="M0,0 H130 Q122,0 122,8 V16 Q122,32 106,32 H24 Q8,32 8,16 V8 Q8,0 0,0 Z"/>
            <TextBlock Text="{Binding Time}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F4F6FA"
                       FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
        </Grid>
        <Grid x:Name="Shell" MouseEnter="EnterShell" MouseLeave="LeaveShell">
            <Grid.Background>
                <LinearGradientBrush x:Name="BottomShadow" MappingMode="Absolute" StartPoint="0,32" EndPoint="0,33">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="#40000000" Offset="0.4"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Border x:Name="BottomEdge" VerticalAlignment="Top" Height="1" Background="#29FFFFFF" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform x:Name="EdgeOffset" Y="31"/></Border.RenderTransform>
            </Border>
            <Grid Height="32" VerticalAlignment="Top">
            <Grid x:Name="CompactAlert" Width="230" HorizontalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False">
                <Grid.RenderTransform><TranslateTransform x:Name="AlertY"/></Grid.RenderTransform>
                <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding AlertGlyph}"
                               FontSize="13" Foreground="{Binding AlertAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding AlertTitle}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                               Foreground="#F4F6FA" VerticalAlignment="Center"/>
                    <ProgressBar Style="{StaticResource AlertProgressBar}" Value="{Binding AlertProgress, Mode=OneWay}"
                                 Width="48" Height="4" Margin="10,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding HasProgress, Converter={StaticResource Visible}}"/>
                </DockPanel>
            </Grid>
            <Grid x:Name="CompactMusic" Width="210" HorizontalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False">
                <Border Margin="-14,0" Opacity=".65"><Border.Background>
                    <RadialGradientBrush Center=".13,.5" GradientOrigin=".13,.5" RadiusX=".6" RadiusY="1.5">
                        <GradientStop Color="{Binding Glow}" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background></Border>
                <Grid Width="22" Height="22" HorizontalAlignment="Left">
                    <Border CornerRadius="5" Background="#29303A"/>
                    <TextBlock Text="&#xE8D6;" Foreground="#D0D9E6" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border CornerRadius="5"><Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Border.Background></Border>
                </Grid>
                <local:ScrollingLabel x:Name="PreviewLabel" Width="142" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <local:SpectrumMeter x:Name="CompactMeter" Width="25" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="CompactStat" Width="200" HorizontalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Time}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F4F6FA" Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="10" Background="#3A4656" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CollapsedStatGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" Foreground="{DynamicResource Theme.Accent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CollapsedStatLabel}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                               Foreground="#C4D2E2" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="CompactClock" Text="{Binding Time}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="#F4F6FA"
                       Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"/>
            </Grid>
            <Grid Width="566" Height="42" Margin="0,15,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                  x:Name="Header" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform><TranslateTransform x:Name="HeaderY"/></Grid.RenderTransform>
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#151820" CornerRadius="13" Padding="4">
                    <Grid>
                        <Border Width="31" Height="30" HorizontalAlignment="Left" Background="#354252" CornerRadius="9">
                            <Border.RenderTransform><TranslateTransform x:Name="PillX"/></Border.RenderTransform>
                        </Border>
                        <StackPanel x:Name="TabButtons" Orientation="Horizontal"/>
                    </Grid>
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Time}" HorizontalAlignment="Center" Foreground="White" FontSize="15"
                               FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{Binding Date}" HorizontalAlignment="Center" Foreground="#A3AFBF" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="PinClick" Content="&#xE718;"/>
                    <Button x:Name="GearButton" Style="{StaticResource IconButton}" Click="SettingsClick" Content="&#xE713;"
                            ToolTip="Settings" AutomationProperties.Name="Settings"/>
                </StackPanel>
            </Grid>
            <Border x:Name="Body" Width="566" Height="222" Margin="0,73,0,0" VerticalAlignment="Top"
                    Opacity="0" Background="{DynamicResource Theme.Surface}" CornerRadius="22" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform x:Name="BodyY"/></Border.RenderTransform>
                <Grid x:Name="Pages" ClipToBounds="True"/>
            </Border>
        </Grid>
    </Grid>
</Window>
