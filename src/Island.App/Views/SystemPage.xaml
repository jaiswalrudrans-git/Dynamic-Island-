<UserControl x:Class="Island.App.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="{DynamicResource Theme.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="MiniCoreBar" TargetType="Border">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="CornerRadius" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Border}"/>
        </Style>

        <Style x:Key="SegmentSortBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="6" Background="{DynamicResource Theme.SurfaceHover}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.BorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 3-COLUMN / 2-ROW RESPONSIVE LAYOUT -->
    <Grid Margin="12,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMN 0: CPU & MEMORY -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: CPU -->
            <Border Grid.Row="0" Style="{StaticResource IslandCard}" ToolTip="{Binding CpuTooltip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row: Label Left, Temp Right -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CPU" FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding CpuTempFormatted}" FontSize="{StaticResource FontSize.Secondary}"
                                   Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"
                                   Visibility="{Binding HasCpuTemp, Converter={StaticResource Visible}}"/>
                    </Grid>

                    <!-- Body Row: Ring Gauge Left, Cores Right -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Usage Ring Gauge -->
                        <Grid Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="46" Height="46" Stroke="{DynamicResource Theme.Border}" StrokeThickness="4"/>
                            <Path x:Name="CpuRingPath" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="{Binding CpuUsageFormatted}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Theme.TextPrimary}" Typography.NumeralAlignment="Tabular"/>
                        </Grid>

                        <!-- Per-Core Bars -->
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding CpuCores}" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel MaxWidth="160" Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="4" Height="20" Margin="1,1" VerticalAlignment="Bottom" ToolTip="{Binding Tooltip}">
                                        <Border CornerRadius="1.5" Background="{DynamicResource Theme.Border}"/>
                                        <Border CornerRadius="1.5" Background="{DynamicResource Theme.Accent}"
                                                VerticalAlignment="Bottom" Height="{Binding Height}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 2: Memory -->
            <Border Grid.Row="2" Style="{StaticResource IslandCard}" ToolTip="{Binding RamTooltip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Memory" FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding RamPercentFormatted}" FontSize="{StaticResource FontSize.Value}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <ProgressBar Grid.Row="2" Style="{StaticResource IslandProgressBar}" Value="{Binding RamPercent, Mode=OneWay}"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="In Use" FontSize="{StaticResource FontSize.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding RamText}" FontSize="{StaticResource FontSize.Label}"
                                   Foreground="{DynamicResource Theme.TextSecondary}" Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- COLUMN 1: GPU & POWER -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 3: GPU -->
            <Border Grid.Row="0" Style="{StaticResource IslandCard}" ToolTip="{Binding GpuTooltip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GpuShortName}" MaxWidth="130" TextTrimming="CharacterEllipsis"
                                   FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GpuUsageFormatted}" FontSize="{StaticResource FontSize.Value}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="{Binding GpuTempFormatted, StringFormat=' · {0}'}" FontSize="{StaticResource FontSize.Secondary}"
                                       Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"
                                       Visibility="{Binding HasGpuTemp, Converter={StaticResource Visible}}"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Grid.Row="2" Style="{StaticResource IslandProgressBar}" Value="{Binding VramPercent, Mode=OneWay}"
                                 Visibility="{Binding HasVram, Converter={StaticResource Visible}}"/>

                    <Grid Grid.Row="4" Visibility="{Binding HasVram, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VRAM" FontSize="{StaticResource FontSize.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding VramText}" FontSize="{StaticResource FontSize.Label}"
                                   Foreground="{DynamicResource Theme.TextSecondary}" Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 4: Power & Battery -->
            <Border Grid.Row="2" Style="{StaticResource IslandCard}" ToolTip="{Binding PowerTooltip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Power label & Watts -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Power" FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding PowerWattsFormatted}" FontSize="{StaticResource FontSize.Value}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <!-- Row 2: Sparkline Curve -->
                    <Canvas Grid.Row="2" Height="26" HorizontalAlignment="Stretch" ClipToBounds="True">
                        <Polyline Points="{Binding PowerPoints}" Stroke="{DynamicResource Theme.Accent}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>

                    <!-- Row 4: Battery & Mean -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="{Binding BatteryGlyph}"
                                   FontSize="14" Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding BatteryPercentFormatted}" FontSize="{StaticResource FontSize.Secondary}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PowerMeanFormatted}" FontSize="{StaticResource FontSize.Label}"
                                   Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"
                                   Visibility="{Binding HasPowerMean, Converter={StaticResource Visible}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- COLUMN 2: NETWORK, STORAGE & TOP PROCESSES -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 5: Network & Storage -->
            <Border Grid.Row="0" Style="{StaticResource IslandCard}" ToolTip="{Binding NetworkTooltip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Network Speeds -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↓" FontSize="{StaticResource FontSize.Body}" Foreground="{DynamicResource Theme.Accent}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DownSpeedFormatted}" FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextPrimary}" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="↑" FontSize="{StaticResource FontSize.Body}" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding UpSpeedFormatted}" FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextPrimary}" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </Grid>

                    <!-- Daily Totals -->
                    <TextBlock Grid.Row="2" Text="{Binding TodayTotalsFormatted}" FontSize="{StaticResource FontSize.Label}"
                               Foreground="{DynamicResource Theme.TextSecondary}" Typography.NumeralAlignment="Tabular"/>

                    <!-- Drives List -->
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ToolTip="{Binding Tooltip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.TextSecondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UsageText}" FontSize="{StaticResource FontSize.Label}"
                                                   Foreground="{DynamicResource Theme.TextSecondary}" Typography.NumeralAlignment="Tabular"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="2" Style="{StaticResource IslandProgressBar}" Height="4" Value="{Binding Percent, Mode=OneWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Card 6: Top Processes -->
            <Border Grid.Row="2" Style="{StaticResource IslandCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row: Title & CPU/RAM Toggle -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Top Apps" FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="CPU" Click="SortCpuClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentSortBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SortByCpu}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="RAM" Click="SortMemoryClick" Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentSortBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SortByMemory}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 5 Process Rows -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="22" Margin="0,1" ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                               FontSize="{StaticResource FontSize.Secondary}" Foreground="{DynamicResource Theme.TextPrimary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MetricText}" FontSize="{StaticResource FontSize.Secondary}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondary}"
                                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
