<UserControl x:Class="Island.App.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="#F2F5FA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="MetricBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2.5" Background="#222B38">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                                        Background="{DynamicResource Theme.Accent}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#141822"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="SortTabButton" TargetType="Button">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#A0AFC2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="5" Background="#1D2432" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#293345"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: CPU, RAM, GPU, Power & Battery -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Card 1: CPU & RAM -->
            <Border Grid.Row="0" Style="{StaticResource Card}" ToolTip="{Binding CpuTooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU Ring Gauge -->
                    <Grid Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="36" Height="36" Stroke="#222B38" StrokeThickness="3.5"/>
                        <Path x:Name="CpuRingPath" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock Text="{Binding CpuUsageFormatted}" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#F1F4FA" Typography.NumeralAlignment="Tabular"/>
                    </Grid>

                    <!-- CPU Info + RAM Info -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- CPU Header & Mini Cores -->
                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="#8E9DAE" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CpuTempFormatted}" FontSize="10" Foreground="#8E9DAE" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding CpuCores}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="3" Height="14" Margin="0.7,0" VerticalAlignment="Center" ToolTip="{Binding Tooltip}">
                                            <Border CornerRadius="1" Background="#222B38"/>
                                            <Border CornerRadius="1" Background="{DynamicResource Theme.Accent}"
                                                    VerticalAlignment="Bottom" Height="{Binding Height}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- RAM Bar & Numbers -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" ToolTip="{Binding RamTooltip}">
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="#8E9DAE"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" FontSize="10" Foreground="#BBC8D8"
                                           Typography.NumeralAlignment="Tabular"/>
                            </DockPanel>
                            <ProgressBar Style="{StaticResource MetricBar}" Value="{Binding RamPercent}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 2: GPU -->
            <Border Grid.Row="2" Style="{StaticResource Card}" ToolTip="{Binding GpuTooltip}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="{Binding GpuName}" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#8E9DAE"/>
                        <TextBlock Text="{Binding GpuUsageFormatted}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#F1F4FA" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{Binding GpuTempFormatted}" FontSize="10" Foreground="#8E9DAE" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding GpuPowerFormatted}" FontSize="10" Foreground="{DynamicResource Theme.Accent}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="VRAM" FontSize="10" Foreground="#8E9DAE"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VramText}" FontSize="10" Foreground="#BBC8D8"
                                       Typography.NumeralAlignment="Tabular"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource MetricBar}" Value="{Binding VramPercent}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Power & Battery -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="106"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 60s Sparkline Curve -->
                    <Grid Grid.Column="0" ToolTip="{Binding PowerTooltip}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="POWER" FontSize="9" FontWeight="Bold" Foreground="#8E9DAE"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PowerWattsFormatted}" FontSize="10"
                                       Foreground="{DynamicResource Theme.Accent}" Typography.NumeralAlignment="Tabular"/>
                        </DockPanel>
                        <Canvas Grid.Row="1" Width="96" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                            <Polyline Points="{Binding PowerPoints}" Stroke="{DynamicResource Theme.Accent}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Grid>

                    <!-- Battery Status -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{Binding BatteryTooltip}">
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding BatteryGlyph}"
                                       FontSize="12" Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BatteryPercentFormatted}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#F1F4FA" Margin="5,0,0,0" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PowerMeanFormatted}" FontSize="9"
                                       Foreground="#8E9DAE" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding BatteryStatusText}" FontSize="10" Foreground="#8E9DAE"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT COLUMN: Network, Storage, Top Processes -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Card 4: Network & Storage -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Network -->
                    <StackPanel Grid.Column="0" ToolTip="{Binding NetworkTooltip}">
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="NET" FontSize="10" FontWeight="Bold" Foreground="#8E9DAE"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DownSpeedFormatted}" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" Typography.NumeralAlignment="Tabular"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="↑" FontSize="10" Foreground="#8E9DAE"/>
                            <TextBlock Text="{Binding UpSpeedFormatted}" FontSize="10" Foreground="#BBC8D8" Margin="4,0,0,0"
                                       Typography.NumeralAlignment="Tabular"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TodayDownFormatted}" FontSize="9" Foreground="#7E8D9F" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>

                    <!-- Storage (Internal Drives) -->
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Drives}" VerticalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,1" ToolTip="{Binding Tooltip}">
                                    <DockPanel Margin="0,0,0,1">
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#8E9DAE"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UsageText}" FontSize="9"
                                                   Foreground="#BBC8D8" Typography.NumeralAlignment="Tabular"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource MetricBar}" Value="{Binding Percent}" Height="4"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Card 5: Top Processes -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with CPU / Memory Toggle -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="TOP PROCESSES" FontSize="10" FontWeight="Bold" Foreground="#8E9DAE" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="CPU" Click="SortCpuClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SortTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SortByCpu}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="RAM" Click="SortMemoryClick" Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SortTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SortByMemory}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Processes List -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="18" Margin="0,1" ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                                   FontSize="11" Foreground="#E2E8F0"/>
                                        <TextBlock Text="{Binding Id, StringFormat=' ({0})'}" FontSize="9" Foreground="#6E7E92"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding MetricText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#BBC8D8" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
