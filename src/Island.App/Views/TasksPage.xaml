<UserControl x:Class="Island.App.Views.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="#F2F5FA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="MiniPillButton" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8E9DAE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="6" Background="#141822" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#222B38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskActionBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#7E8D9F"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#222B38"/>
                                <Setter Property="Foreground" Value="#F2F5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Input Row -->
        <DockPanel Grid.Row="0">
            <!-- Filter Pills -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Style="{StaticResource MiniPillButton}" Content="All" Click="FilterAllClick"/>
                <Button Style="{StaticResource MiniPillButton}" Content="Active" Click="FilterActiveClick" Margin="4,0,0,0"/>
                <Button Style="{StaticResource MiniPillButton}" Content="Done" Click="FilterDoneClick" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- Priority Selector -->
            <Button DockPanel.Dock="Right" x:Name="PriorityBtn" Style="{StaticResource MiniPillButton}"
                    Content="Med" Margin="6,0,0,0" ToolTip="Priority" Click="CyclePriorityClick"/>

            <!-- Add Button -->
            <Button DockPanel.Dock="Right" Style="{StaticResource TaskActionBtn}" Width="26" Height="26"
                    Content="&#xE710;" Margin="4,0,0,0" Click="AddTaskClick" ToolTip="Add Task"/>

            <!-- Text Box -->
            <Border Background="#141822" CornerRadius="8" Padding="6,2">
                <TextBox x:Name="TaskInput" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#F2F5FA" FontSize="12" VerticalAlignment="Center"
                         KeyDown="TaskInputKeyDown" GotFocus="TaskInputGotFocus" LostFocus="TaskInputLostFocus"/>
            </Border>
        </DockPanel>

        <!-- Tasks List -->
        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <!-- Empty State -->
                <Grid Height="120" Visibility="{Binding HasTasks, Converter={StaticResource Visible}, ConverterParameter=invert}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTasks}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="22" Foreground="#5E6D7E" HorizontalAlignment="Center"/>
                        <TextBlock Text="No tasks here. Add one above!" FontSize="12" Foreground="#7E8D9F"
                                   Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Tasks Items -->
                <ItemsControl ItemsSource="{Binding FilteredTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#141822" CornerRadius="8" Padding="8,5" Margin="0,2">
                                <DockPanel LastChildFill="True">
                                    <!-- Delete Button -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TaskActionBtn}" Content="&#xE74D;"
                                            Tag="{Binding Id}" Click="DeleteClick" ToolTip="Delete"/>
                                    <!-- Move Down -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TaskActionBtn}" Content="&#xE74B;"
                                            Tag="{Binding Id}" Click="MoveDownClick" ToolTip="Move Down"/>
                                    <!-- Move Up -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TaskActionBtn}" Content="&#xE74A;"
                                            Tag="{Binding Id}" Click="MoveUpClick" ToolTip="Move Up"/>

                                    <!-- Priority Badge -->
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Background="{Binding PriorityBrush}"
                                            Padding="5,1" Margin="6,0,6,0" VerticalAlignment="Center" Opacity=".85">
                                        <TextBlock Text="{Binding PriorityText}" FontSize="9" FontWeight="Bold" Foreground="#12161F"/>
                                    </Border>

                                    <!-- Due Badge -->
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DueText}" FontSize="10" Foreground="#8E9DAE"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <!-- Check Button -->
                                    <Button Style="{StaticResource TaskActionBtn}" Width="20" Height="20" Margin="0,0,8,0"
                                            Tag="{Binding Id}" Click="ToggleClick">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                   Text="{Binding IsCompleted, Converter={x:Null}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE739;"/>
                                                    <Setter Property="Foreground" Value="#5E6D7E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Text" Value="&#xE73E;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <!-- Title -->
                                    <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F2F5FA"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#6E7E92"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
