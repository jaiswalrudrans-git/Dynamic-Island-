<UserControl x:Class="Island.App.Views.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#F2F5FA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="FilterPillBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#7E8D9F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="6" Background="#141822" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#222B38"/>
                                <Setter Property="Foreground" Value="#F2F5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskActionBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#6B7C90"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#222B38"/>
                                <Setter Property="Foreground" Value="#F2F5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteActionBtn" TargetType="Button" BasedOn="{StaticResource TaskActionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#33FF5252"/>
                                <Setter Property="Foreground" Value="#FF5252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Input & Filter Row -->
        <DockPanel Grid.Row="0">
            <!-- Filter Pills on the Right -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Content="All" Click="FilterAllClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterPillBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAllFilter}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Active" Click="FilterActiveClick" Margin="4,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterPillBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActiveFilter}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Done" Click="FilterDoneClick" Margin="4,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterPillBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDoneFilter}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Priority Selector -->
            <Button DockPanel.Dock="Right" Style="{StaticResource FilterPillBtn}"
                    Content="{Binding NewTaskPriorityText}" Foreground="{Binding NewTaskPriorityBrush}"
                    Margin="6,0,0,0" ToolTip="Priority: Click to cycle (Low / Med / High)" Click="CyclePriorityClick"/>

            <!-- Add Button -->
            <Button DockPanel.Dock="Right" Style="{StaticResource TaskActionBtn}" Width="28" Height="28"
                    Content="&#xE710;" Margin="4,0,0,0" Click="AddTaskClick" ToolTip="Add Task (or press Enter)"/>

            <!-- Text Box with Watermark -->
            <Border Background="#141822" CornerRadius="8" Padding="10,0" BorderThickness="1" BorderBrush="#242E3E">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Add a task... (Press Enter to save)" Foreground="#5E6D7E" FontSize="12"
                               IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInput}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="TaskInput" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#F2F5FA" CaretBrush="{DynamicResource Theme.Accent}" FontSize="12" VerticalAlignment="Center"
                             PreviewMouseLeftButtonDown="TaskInputPreviewMouseDown"
                             KeyDown="TaskInputKeyDown" GotFocus="TaskInputGotFocus" LostFocus="TaskInputLostFocus"/>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Tasks Content Area -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <!-- Empty State -->
            <Grid Height="120" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#161B26" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18" Foreground="#5E6D7E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No tasks here" FontSize="13" FontWeight="SemiBold" Foreground="#8E9DAE"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Type above and press Enter to add one" FontSize="11" Foreground="#5E6D7E"
                               Margin="0,3,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Tasks Items List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding HasFilteredTasks, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding FilteredTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#141822" CornerRadius="8" Padding="10,6" Margin="0,3"
                                    BorderThickness="1" BorderBrush="#1F2837">
                                <DockPanel LastChildFill="True">
                                    <!-- Delete Button -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DeleteActionBtn}" Content="&#xE74D;"
                                            Tag="{Binding Id}" Click="DeleteClick" ToolTip="Delete task"/>
                                    <!-- Move Down -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TaskActionBtn}" Content="&#xE74B;"
                                            Tag="{Binding Id}" Click="MoveDownClick" ToolTip="Move Down"/>
                                    <!-- Move Up -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TaskActionBtn}" Content="&#xE74A;"
                                            Tag="{Binding Id}" Click="MoveUpClick" ToolTip="Move Up"/>

                                    <!-- Priority Badge -->
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Background="{Binding PriorityBrush}"
                                            Padding="6,1" Margin="6,0,6,0" VerticalAlignment="Center" Opacity=".9">
                                        <TextBlock Text="{Binding PriorityText}" FontSize="9" FontWeight="Bold" Foreground="#12161F"/>
                                    </Border>

                                    <!-- Due Badge -->
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DueText}" FontSize="10" Foreground="#8E9DAE"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <!-- Check Button -->
                                    <Button Width="22" Height="22" Margin="0,0,8,0" Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Focusable="False" Tag="{Binding Id}" Click="ToggleClick" ToolTip="Toggle complete">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="16" Height="16" CornerRadius="4" BorderThickness="1.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#4E5D72"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                                                    <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                               Text="&#xE73E;" Foreground="#121620" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Title -->
                                    <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F2F5FA"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
