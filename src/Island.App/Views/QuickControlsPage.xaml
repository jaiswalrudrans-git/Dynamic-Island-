<UserControl x:Class="Island.App.Views.QuickControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="{DynamicResource Theme.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <!-- ACTION TILE STYLE (No border at rest, border on hover) -->
        <Style x:Key="QuickTileBtn" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceRaised}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardRestBorder}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="{StaticResource Radius.Control}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,4,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FULL-WIDTH SLIDER 1: VOLUME -->
        <Border Grid.Row="0" Style="{StaticResource IslandCard}" Padding="14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Slider Row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource IslandIconButton}" Width="32" Height="32"
                            Content="{Binding VolumeGlyph}" Click="VolumeMuteClick" ToolTip="Toggle Mute"/>

                    <Slider Grid.Column="1" Style="{StaticResource IslandFullSlider}" Minimum="0" Maximum="1"
                            Value="{Binding VolumeFraction, Mode=TwoWay}" Margin="12,0" AutomationProperties.Name="Volume"/>

                    <TextBlock Grid.Column="2" Text="{Binding VolumePercentText}"
                               FontFamily="{DynamicResource Typography.Family.Numeric}"
                               FontSize="{DynamicResource Typography.Size.Value}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- Output Device Chip Row -->
                <Border Grid.Row="1" HorizontalAlignment="Left" CornerRadius="4"
                        Background="{DynamicResource Theme.SurfaceHover}" Padding="6,2" Margin="38,2,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE767;" FontSize="10"
                                   Foreground="{DynamicResource Theme.Accent}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OutputDeviceName}"
                                   FontFamily="{DynamicResource Typography.Family.Label}"
                                   FontSize="{DynamicResource Typography.Size.Label}"
                                   Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- FULL-WIDTH SLIDER 2: BRIGHTNESS -->
        <Border Grid.Row="2" Style="{StaticResource IslandCard}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#xE706;" FontFamily="{StaticResource Font.Icons}" FontSize="18"
                           Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="32" TextAlignment="Center"/>

                <Slider Grid.Column="1" Style="{StaticResource IslandFullSlider}" Minimum="0" Maximum="100"
                        Value="{Binding Brightness, Mode=TwoWay}" Margin="12,0" AutomationProperties.Name="Brightness"/>

                <TextBlock Grid.Column="2" Text="{Binding BrightnessText}"
                           FontFamily="{DynamicResource Typography.Family.Numeric}"
                           FontSize="{DynamicResource Typography.Size.Value}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </Border>

        <!-- 8 ACTION TILES IN 4x2 GRID (ZERO EMPTY SLOTS) -->
        <!-- Row 1 of Tiles -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Mic -->
            <Button Grid.Column="0" Style="{StaticResource QuickTileBtn}" Click="MicClick" ToolTip="Toggle Microphone">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                        <Setter Property="Background" Value="#33FF5252"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="{Binding MicGlyph}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Mic" FontFamily="{DynamicResource Typography.Family.Heading}"
                                   FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="{Binding MicStatusText}" FontFamily="{DynamicResource Typography.Family.Label}"
                                   FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 2. Wi-Fi -->
            <Button Grid.Column="2" Style="{StaticResource QuickTileBtn}" Click="WifiClick" ToolTip="Toggle Wi-Fi">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWifiActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="{Binding WifiGlyph}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWifiActive}" Value="True">
                                            <Setter Property="Foreground" Value="#0A0E14"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Wi-Fi" FontFamily="{DynamicResource Typography.Family.Heading}"
                                   FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="{Binding WifiStatusText}" FontFamily="{DynamicResource Typography.Family.Label}"
                                   FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 3. Bluetooth -->
            <Button Grid.Column="4" Style="{StaticResource QuickTileBtn}" Click="BluetoothClick" ToolTip="Toggle Bluetooth">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBluetoothActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="{Binding BluetoothGlyph}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBluetoothActive}" Value="True">
                                            <Setter Property="Foreground" Value="#0A0E14"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Bluetooth" FontFamily="{DynamicResource Typography.Family.Heading}"
                                   FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="{Binding BluetoothStatusText}" FontFamily="{DynamicResource Typography.Family.Label}"
                                   FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 4. Focus Assist -->
            <Button Grid.Column="6" Style="{StaticResource QuickTileBtn}" Click="DndClick" ToolTip="Focus Assist Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Theme.SurfaceHover}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE708;" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Accent}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Focus" FontFamily="{DynamicResource Typography.Family.Heading}"
                                   FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="{Binding FocusAssistStatusText}" FontFamily="{DynamicResource Typography.Family.Label}"
                                   FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <!-- Row 2 of Tiles -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 5. Snip (Scissors Icon \uE8C6) -->
            <Button Grid.Column="0" Style="{StaticResource QuickTileBtn}" Click="ScreenshotClick" ToolTip="Screen Snipping (Win+Shift+S)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Theme.SurfaceHover}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE8C6;" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Snip" FontFamily="{DynamicResource Typography.Family.Heading}"
                                   FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="Screenshot" FontFamily="{DynamicResource Typography.Family.Label}"
                                   FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 6. Lock -->
            <Button Grid.Column="2" Style="{StaticResource QuickTileBtn}" Click="LockClick" ToolTip="Lock PC">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Theme.SurfaceHover}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE72E;" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Lock" FontFamily="{DynamicResource Typography.Family.Heading}"
                                   FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="PC" FontFamily="{DynamicResource Typography.Family.Label}"
                                   FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 7. Sleep -->
            <Button Grid.Column="4" Style="{StaticResource QuickTileBtn}" Click="SleepClick" ToolTip="Sleep PC">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Theme.SurfaceHover}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE7E8;" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Sleep" FontFamily="{DynamicResource Typography.Family.Heading}"
                                   FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="Suspend" FontFamily="{DynamicResource Typography.Family.Label}"
                                   FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 8. Task Manager (No empty slots!) -->
            <Button Grid.Column="6" Style="{StaticResource QuickTileBtn}" Click="TaskManagerClick" ToolTip="Open Task Manager">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Theme.SurfaceHover}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE9D9;" FontSize="13"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Tasks" FontFamily="{DynamicResource Typography.Family.Heading}"
                                   FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="Manager" FontFamily="{DynamicResource Typography.Family.Label}"
                                   FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
