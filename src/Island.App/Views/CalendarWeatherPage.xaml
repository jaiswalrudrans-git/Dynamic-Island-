<UserControl x:Class="Island.App.Views.CalendarWeatherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="#F2F5FA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="CalNavBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8E9DAE"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#222B38"/>
                                <Setter Property="Foreground" Value="#F2F5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniPillBtn" TargetType="Button">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8E9DAE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="4" Background="#141822" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#222B38"/>
                                <Setter Property="Foreground" Value="#F2F5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Calendar -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="114"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Month Header -->
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CalNavBtn}" Content="&#xE76B;" Click="PrevMonthClick" ToolTip="Previous Month"/>
                    <Button Style="{StaticResource MiniPillBtn}" Content="Today" Margin="2,0" Click="TodayClick" ToolTip="Jump to Today"/>
                    <Button Style="{StaticResource CalNavBtn}" Content="&#xE76C;" Click="NextMonthClick" ToolTip="Next Month"/>
                    <Button Style="{StaticResource CalNavBtn}" Content="&#xE710;" Margin="4,0,0,0" Click="ToggleAddEventClick" ToolTip="Add Event"/>
                </StackPanel>
                <TextBlock Text="{Binding MonthYearText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="#F2F5FA" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Day of Week Header -->
            <UniformGrid Grid.Row="1" Columns="7" Margin="0,2,0,0">
                <TextBlock Text="M" FontSize="9" FontWeight="Bold" Foreground="#5E6D7E" HorizontalAlignment="Center"/>
                <TextBlock Text="T" FontSize="9" FontWeight="Bold" Foreground="#5E6D7E" HorizontalAlignment="Center"/>
                <TextBlock Text="W" FontSize="9" FontWeight="Bold" Foreground="#5E6D7E" HorizontalAlignment="Center"/>
                <TextBlock Text="T" FontSize="9" FontWeight="Bold" Foreground="#5E6D7E" HorizontalAlignment="Center"/>
                <TextBlock Text="F" FontSize="9" FontWeight="Bold" Foreground="#5E6D7E" HorizontalAlignment="Center"/>
                <TextBlock Text="S" FontSize="9" FontWeight="Bold" Foreground="#5E6D7E" HorizontalAlignment="Center"/>
                <TextBlock Text="S" FontSize="9" FontWeight="Bold" Foreground="#5E6D7E" HorizontalAlignment="Center"/>
            </UniformGrid>

            <!-- 42 Days Month Grid -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding MonthDays}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Background="{Binding BackgroundBrush}" BorderThickness="0" Focusable="False"
                                Cursor="Hand" Tag="{Binding Date}" Click="DayCellClick" Margin="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Today Circle -->
                                            <Border Width="16" Height="16" CornerRadius="8"
                                                    Background="{DynamicResource Theme.Accent}"
                                                    Visibility="{Binding IsToday, Converter={StaticResource Visible}}"/>
                                            <TextBlock Text="{Binding DayNumber}" FontSize="10"
                                                       Foreground="{Binding ForegroundBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="#121620"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Event indicator dot -->
                                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Theme.Accent}"
                                                     VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-4"
                                                     Visibility="{Binding HasEvents, Converter={StaticResource Visible}}"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Selected Date / Events Bar -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <!-- Add Event Mode -->
                <Grid Visibility="{Binding IsAddingEvent, Converter={StaticResource Visible}}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource CalNavBtn}" Content="&#xE711;"
                                Click="CancelAddEventClick" ToolTip="Cancel"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CalNavBtn}" Content="&#xE73E;"
                                Click="SaveAddEventClick" ToolTip="Save"/>
                        <Border Background="#141822" CornerRadius="6" Padding="6,1" BorderThickness="1" BorderBrush="#252F40">
                            <TextBox x:Name="EventInput" Text="{Binding NewEventTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="#F2F5FA" FontSize="11"
                                     CaretBrush="{DynamicResource Theme.Accent}" KeyDown="EventInputKeyDown"/>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- Normal Events Display Mode -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddingEvent}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <!-- Empty Day State -->
                            <TextBlock Text="{Binding SelectedDateHeader, StringFormat='{}{0}: No events scheduled'}"
                                       FontSize="10" Foreground="#7E8D9F" VerticalAlignment="Center"
                                       Visibility="{Binding HasEventsForSelectedDay, Converter={StaticResource Visible}, ConverterParameter=invert}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEventsForSelectedDay}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Event Items -->
                            <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141822" CornerRadius="5" Padding="6,3" Margin="0,1"
                                                BorderThickness="1" BorderBrush="#1F2837">
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource CalNavBtn}" Content="&#xE74D;"
                                                        Tag="{Binding Id}" Click="DeleteEventClick" ToolTip="Delete event" Width="18" Height="18"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="9"
                                                           Foreground="#8E9DAE" VerticalAlignment="Center" Margin="6,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#F2F5FA"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- RIGHT COLUMN: Weather Card -->
        <Border Grid.Column="2" Background="#141822" CornerRadius="12" Padding="12,10"
                BorderThickness="1" BorderBrush="#1F2837">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Current Weather Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon & Temp -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding CurrentGlyph}"
                                   FontSize="26" Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CurrentTemp}" FontSize="24" FontWeight="Bold"
                                   Foreground="#F2F5FA" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>

                    <!-- Condition & City -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding CurrentCondition}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding HighLow}" FontSize="10" Foreground="#8E9DAE" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- City Button & Refresh -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MiniPillBtn}" Content="{Binding WeatherCity}"
                                Click="CityClick" ToolTip="Click to change city"/>
                        <Button Style="{StaticResource CalNavBtn}" Content="&#xE72C;" Margin="4,0,0,0"
                                Click="RefreshWeatherClick" ToolTip="Refresh Weather"/>
                    </StackPanel>
                </Grid>

                <!-- Hourly Forecast Strip -->
                <Border Grid.Row="1" Margin="0,6,0,4" Background="#10141D" CornerRadius="8" Padding="6,2">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding HourlyForecast}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding HourDisplay}" FontSize="8" Foreground="#7E8D9F" HorizontalAlignment="Center"/>
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}"
                                                   FontSize="11" Foreground="{DynamicResource Theme.Accent}" Margin="0,1" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FormattedTemperature}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#F2F5FA" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 5-Day Daily Forecast Strip -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding DailyForecast}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DayDisplay}" FontSize="10" Foreground="#BBC8D8" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}"
                                           FontSize="11" Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding FormattedHighLow}" FontSize="10" Foreground="#8E9DAE"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
