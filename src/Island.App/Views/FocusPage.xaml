<UserControl x:Class="Island.App.Views.FocusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="#F2F5FA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="ModePillBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8E9DAE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="6" Background="#141822" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#222B38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusControlBtn" TargetType="Button">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#1A202C"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F2F5FA"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="18" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#293345"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource FocusControlBtn}">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Foreground" Value="#121620"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="24" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Mode Bar -->
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Pomodoro" Click="PomodoroModeClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModePillBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPomodoro}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Timer" Click="TimerModeClick" Margin="4,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModePillBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTimer}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Stopwatch" Click="StopwatchModeClick" Margin="4,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModePillBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStopwatch}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StageText}" FontSize="12" FontWeight="SemiBold" Foreground="#BBC8D8"/>
                <TextBlock Text="{Binding CycleText, StringFormat=' · {0}'}" FontSize="11" Foreground="#7E8D9F"
                           Visibility="{Binding IsPomodoro, Converter={StaticResource Visible}}"/>
            </StackPanel>
        </DockPanel>

        <!-- Main Focus Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Center Clock & Transport -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Digital Time Display -->
                <TextBlock Text="{Binding DisplayTime}" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="#F4F6FA" Typography.NumeralAlignment="Tabular" Margin="0,0,0,10"/>

                <!-- Preset Buttons for Timer Mode -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12"
                            Visibility="{Binding IsTimer, Converter={StaticResource Visible}}">
                    <Button Style="{StaticResource ModePillBtn}" Content="5m" Click="Timer5Click"/>
                    <Button Style="{StaticResource ModePillBtn}" Content="10m" Click="Timer10Click" Margin="4,0,0,0"/>
                    <Button Style="{StaticResource ModePillBtn}" Content="15m" Click="Timer15Click" Margin="4,0,0,0"/>
                    <Button Style="{StaticResource ModePillBtn}" Content="25m" Click="Timer25Click" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Controls Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Reset -->
                    <Button Style="{StaticResource FocusControlBtn}" Content="&#xE777;" Click="ResetClick" ToolTip="Reset"/>

                    <!-- Play / Pause -->
                    <Button Style="{StaticResource PlayBtn}" Content="{Binding PlayPauseGlyph}" Click="PlayPauseClick"
                            Margin="16,0" ToolTip="{Binding PlayPauseText}"/>

                    <!-- Skip (Pomodoro) or Lap (Stopwatch) -->
                    <Button Style="{StaticResource FocusControlBtn}" Content="&#xE893;" Click="SkipClick" ToolTip="Skip Stage"
                            Visibility="{Binding IsPomodoro, Converter={StaticResource Visible}}"/>
                    <Button Style="{StaticResource FocusControlBtn}" Content="&#xE7C0;" Click="LapClick" ToolTip="Lap"
                            Visibility="{Binding IsStopwatch, Converter={StaticResource Visible}}"/>
                </StackPanel>
            </StackPanel>

            <!-- Stopwatch Laps Sidebar -->
            <ScrollViewer Grid.Column="1" Width="140" MaxHeight="140" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding IsStopwatch, Converter={StaticResource Visible}}" Margin="10,0,0,0">
                <ItemsControl ItemsSource="{Binding LapStrings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#141822" CornerRadius="6" Padding="6,3" Margin="0,2">
                                <TextBlock Text="{Binding}" FontSize="10" Foreground="#BBC8D8" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
