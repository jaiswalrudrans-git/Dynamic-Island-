<UserControl x:Class="Island.App.Views.FocusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="{DynamicResource Theme.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Secondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetChip" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Label}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="6"
                                Background="{DynamicResource Theme.SurfaceRaised}"
                                BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusControlBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayBtn" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Foreground" Value="#121620"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{DynamicResource Theme.NeonGlow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,8,16,14">
        <Grid.RowDefinitions>
            <!-- Row 0: Segment Control (Pomodoro | Timer | Stopwatch) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Subtitle ("Work · 1 of 4") -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Centered Circular Progress Ring (150x150) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Preset Chips (15m, 25m, 45m, 60m) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Controls Row (Reset, Play/Pause, Skip/Lap) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: Segment Control -->
        <Border Grid.Row="0" HorizontalAlignment="Center" Background="{DynamicResource Theme.SurfaceRaised}"
                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6"
                Padding="2" ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
                <Button Content="Pomodoro" Click="PomodoroModeClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPomodoro}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Timer" Click="TimerModeClick" Margin="3,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTimer}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Stopwatch" Click="StopwatchModeClick" Margin="3,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStopwatch}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ROW 1: Mode Title & Cycle Dots ("Work · 1 of 4") -->
        <TextBlock Grid.Row="1" Text="{Binding CycleSubtitle}" FontSize="{StaticResource Font.Secondary}"
                   FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondary}"
                   HorizontalAlignment="Center" Margin="0,8,0,6"/>

        <!-- ROW 2: Circular Progress Ring (150x150) with Digital Timer -->
        <Grid Grid.Row="2" x:Name="RingGrid" Width="150" Height="150" HorizontalAlignment="Center">
            <!-- Background Track Ring -->
            <Ellipse Width="138" Height="138" Stroke="{DynamicResource Theme.Border}"
                     StrokeThickness="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}"/>

            <!-- Active Progress Arc (Cyan Data with Glow) -->
            <Path x:Name="RingPath" Stroke="{DynamicResource Theme.Data}" StrokeThickness="5"
                  Effect="{DynamicResource Theme.DataGlow}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}"/>

            <!-- Digital Timer (Lining tabular figures) -->
            <TextBlock Text="{Binding DisplayTime}" FontSize="44" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.TextPrimary}"
                       FontFamily="{StaticResource Font.FamilyDisplay}"
                       Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"/>
        </Grid>

        <!-- ROW 3: Preset Chips for Timer Mode (15m, 25m, 45m, 60m) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4"
                    Visibility="{Binding IsTimer, Converter={StaticResource Visible}}">
            <Button Style="{StaticResource PresetChip}" Content="15m" Click="Timer15Click"/>
            <Button Style="{StaticResource PresetChip}" Content="25m" Click="Timer25Click" Margin="6,0,0,0"/>
            <Button Style="{StaticResource PresetChip}" Content="45m" Click="Timer45Click" Margin="6,0,0,0"/>
            <Button Style="{StaticResource PresetChip}" Content="60m" Click="Timer60Click" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- ROW 4: Action Controls Row (Reset, Play/Pause, Skip/Lap) -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,4">
            <!-- Reset -->
            <Button Style="{StaticResource FocusControlBtn}" Content="&#xE777;" Click="ResetClick" ToolTip="Reset"/>

            <!-- Play / Pause -->
            <Button Style="{StaticResource PlayBtn}" Content="{Binding PlayPauseGlyph}" Click="PlayPauseClick"
                    Margin="16,0" ToolTip="{Binding PlayPauseText}"/>

            <!-- Skip (Pomodoro) or Lap (Stopwatch) -->
            <Button Style="{StaticResource FocusControlBtn}" Content="&#xE893;" Click="SkipClick" ToolTip="Skip Stage"
                    Visibility="{Binding IsPomodoro, Converter={StaticResource Visible}}"/>
            <Button Style="{StaticResource FocusControlBtn}" Content="&#xE7C0;" Click="LapClick" ToolTip="Lap"
                    Visibility="{Binding IsStopwatch, Converter={StaticResource Visible}}"/>
        </StackPanel>
    </Grid>
</UserControl>
