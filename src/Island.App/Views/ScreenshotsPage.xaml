<UserControl x:Class="Island.App.Views.ScreenshotsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="{DynamicResource Theme.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <!-- Mini Action Button -->
        <Style x:Key="ThumbActionBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#CC000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="4" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji"
                                       FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                <Setter Property="Foreground" Value="#121620"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Snip Action Button in Header -->
        <Style x:Key="SnipHeaderBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Foreground" Value="#121620"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource Typography.Size.Secondary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Typography.Family.Heading}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji"
                                           FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Snip" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,4,12,10">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Action Bar (Title, Count, Snip Button) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Thumbnails Grid / Empty State -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Strip -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Screenshots" FontFamily="{DynamicResource Typography.Family.Heading}"
                           FontSize="{DynamicResource Typography.Size.SectionTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalCount, StringFormat=' ({0})'}"
                           FontFamily="{DynamicResource Typography.Family.Numeric}"
                           FontSize="{DynamicResource Typography.Size.Secondary}"
                           Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource SnipHeaderBtn}" Click="SnipClick"
                    ToolTip="Take Screenshot (Win+Shift+S)"/>
        </Grid>

        <!-- ROW 1: Thumbnails Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="360" Focusable="False">
            <Grid>
                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,32"
                            Visibility="{Binding TotalCount, Converter={StaticResource Visible}}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji"
                               FontSize="32" Foreground="{DynamicResource Theme.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="No screenshots yet" FontFamily="{DynamicResource Typography.Family.Heading}"
                               FontSize="{DynamicResource Typography.Size.Secondary}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click 'Snip' or press Win+Shift+S to capture."
                               FontFamily="{DynamicResource Typography.Family.Body}"
                               FontSize="{DynamicResource Typography.Size.Label}" Foreground="{DynamicResource Theme.TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Grid Items -->
                <ItemsControl ItemsSource="{Binding DisplayedItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="130" ItemHeight="100"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" CornerRadius="8" Background="{DynamicResource Theme.SurfaceRaised}"
                                    BorderBrush="{DynamicResource Theme.CardRestBorder}" BorderThickness="1"
                                    ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="ThumbnailClick"
                                    MouseMove="ThumbnailMouseMove" ToolTip="{Binding DisplayTitle}">
                                <Grid>
                                    <!-- Image Thumbnail Host -->
                                    <Image x:Name="ThumbImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Loaded="ThumbImageLoaded"/>

                                    <!-- Bottom Info Badge -->
                                    <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="4,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DimensionsText}" FontFamily="{DynamicResource Typography.Family.Numeric}"
                                                       FontSize="9" Foreground="#EEEEEE" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RelativeTime}" FontFamily="{DynamicResource Typography.Family.Numeric}"
                                                       FontSize="9" Foreground="#B0B0B0" Typography.NumeralAlignment="Tabular"/>
                                        </Grid>
                                    </Border>

                                    <!-- Hover Action Bar (Top Right) -->
                                    <Border x:Name="HoverBar" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="3"
                                            Opacity="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ThumbActionBtn}" Content="{Binding PinGlyph}"
                                                    Click="PinClick" Tag="{Binding Id}" ToolTip="Pin"/>
                                            <Button Style="{StaticResource ThumbActionBtn}" Content="&#xE8C8;"
                                                    Click="CopyClick" Tag="{Binding Id}" Margin="2,0,0,0" ToolTip="Copy Image"/>
                                            <Button Style="{StaticResource ThumbActionBtn}" Content="&#xE8E5;"
                                                    Click="OpenClick" Tag="{Binding Id}" Margin="2,0,0,0" ToolTip="Open Image"/>
                                            <Button Style="{StaticResource ThumbActionBtn}" Content="&#xE74D;"
                                                    Click="DeleteClick" Tag="{Binding Id}" Margin="2,0,0,0" ToolTip="Delete"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
