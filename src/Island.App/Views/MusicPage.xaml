<UserControl x:Class="Island.App.Views.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Island.App.Views"
             Focusable="False" Foreground="{DynamicResource Theme.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <Style x:Key="SeekRail" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border VerticalAlignment="Center" Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Transport" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,8,16,12">
        <!-- Radial Cover Glow (Subtle ambient effect directly on the island) -->
        <Border CornerRadius="{StaticResource Radius.Card}" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0.4" GradientOrigin="0.12,0.4" RadiusX="0.9" RadiusY="1.4">
                    <GradientStop Color="{Binding Glow}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Empty State -->
        <Grid x:Name="Empty" Margin="24,32">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPlayer}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32"
                           Foreground="{DynamicResource Theme.Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyStatus}" FontSize="{StaticResource Font.Title}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                <TextBlock Text="Play audio in Spotify, a browser, or media player."
                           Foreground="{DynamicResource Theme.TextSecondary}" FontSize="{StaticResource Font.Secondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Active Player Content -->
        <Grid Visibility="{Binding HasPlayer, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <!-- Row 0: Player Selector & Spectrum -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Cover + Meta + Lyrics -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Seek bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Transport controls -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Player Chip & Spectrum Meter -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <local:SpectrumMeter x:Name="Meter" DockPanel.Dock="Right" Width="32" Height="18"
                                    VerticalAlignment="Center" ToolTip="Default output spectrum"/>

                <Button HorizontalAlignment="Left" Click="ChoosePlayer" Focusable="False"
                        ToolTip="Choose or pin player" AutomationProperties.Name="Choose or pin a player"
                        Background="{DynamicResource Theme.SurfaceRaised}" BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1" Cursor="Hand" Padding="8,3">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Player Icon (Spotify / Web / Player) -->
                        <TextBlock Text="{Binding PlayerIconGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="{StaticResource Font.Secondary}" Foreground="{DynamicResource Theme.Accent}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <!-- Player Name -->
                        <TextBlock Text="{Binding Player}" MaxWidth="280" TextTrimming="CharacterEllipsis"
                                   FontSize="{StaticResource Font.Label}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Margin="6,1,0,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70D;"
                                   FontSize="9" Foreground="{DynamicResource Theme.TextTertiary}" VerticalAlignment="Center"/>
                        <TextBlock Margin="5,1,0,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE718;"
                                   FontSize="10" Foreground="{DynamicResource Theme.Accent}"
                                   Visibility="{Binding Pinned, Converter={StaticResource Visible}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Row 1: Cover Art & Track Info -->
            <Grid Grid.Row="1" Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cover Art with Rounded Corners -->
                <Grid Grid.Column="0" Width="96" Height="96" VerticalAlignment="Center">
                    <Border CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Theme.SurfaceRaised}"
                            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"/>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32"
                               Foreground="{DynamicResource Theme.TextTertiary}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8D6;"
                               Visibility="{Binding MissingCover, Converter={StaticResource Visible}}"/>
                    <Border CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- Title, Artist & Lyrics -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextPrimary}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Artist}" FontSize="{StaticResource Font.Body}"
                               Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Lyrics Display -->
                    <Grid Margin="0,8,0,0" Height="36" ClipToBounds="True" Visibility="{Binding ShowLyrics, Converter={StaticResource Visible}}">
                        <Canvas>
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="LyricY"/>
                            </Canvas.RenderTransform>
                            <TextBlock Canvas.Top="-18" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                       Text="{Binding PreviousLyric}" FontSize="{StaticResource Font.Label}"
                                       Foreground="{DynamicResource Theme.TextTertiary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                       Text="{Binding LyricDisplay}" FontSize="{StaticResource Font.Secondary}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LyricDisplay}"/>
                            <TextBlock Canvas.Top="18" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                       Text="{Binding NextLyric}" FontSize="{StaticResource Font.Label}"
                                       Foreground="{DynamicResource Theme.TextTertiary}" TextTrimming="CharacterEllipsis"/>
                        </Canvas>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Row 2: Seek Rail -->
            <Grid Grid.Row="2" Margin="0,2,0,8" Visibility="{Binding HasTimeline, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Elapsed}" VerticalAlignment="Center" FontSize="{StaticResource Font.Label}"
                           Foreground="{DynamicResource Theme.TextTertiary}" Typography.NumeralAlignment="Tabular"/>
                <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" Margin="10,0"
                        Value="{Binding Fraction, Mode=OneWay}" IsEnabled="{Binding CanSeek}"
                        VerticalAlignment="Center" Focusable="False" AutomationProperties.Name="Playback position"
                        IsMoveToPointEnabled="True" Cursor="Hand">
                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">
                            <Grid Height="20" Background="Transparent" Cursor="Hand">
                                <Track x:Name="PART_Track" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SeekRail}" Background="{DynamicResource Theme.Data}"
                                                      Command="Slider.DecreaseLarge"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="12" Height="12" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="{DynamicResource Theme.TextPrimary}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SeekRail}" Background="{DynamicResource Theme.BorderStrong}"
                                                      Command="Slider.IncreaseLarge"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Slider.Template>
                </Slider>
                <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center" FontSize="{StaticResource Font.Label}"
                           Foreground="{DynamicResource Theme.TextTertiary}" Typography.NumeralAlignment="Tabular"/>
            </Grid>

            <!-- Row 3: Transport Controls -->
            <StackPanel x:Name="TransportButtons" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Tag="Shuffle" Click="Transport" Content="&#xE8B1;" ToolTip="Shuffle" AutomationProperties.Name="Shuffle"
                        IsEnabled="{Binding CanShuffle}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Transport}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shuffled}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource Transport}" Tag="Previous" Click="Transport" Content="&#xE892;"
                        IsEnabled="{Binding CanPrevious}" ToolTip="Previous track" Margin="8,0,0,0"/>

                <!-- Play / Pause Main Button (Primary action with glow) -->
                <Button Style="{StaticResource Transport}" Tag="Toggle" Click="Transport" Content="{Binding PlayGlyph}"
                        IsEnabled="{Binding CanToggle}" Background="{DynamicResource Theme.Accent}" Foreground="#121620"
                        Width="48" Height="48" Margin="12,0" ToolTip="{Binding PlayHint}" FontSize="18">
                    <Button.Effect>
                        <DropShadowEffect Color="#FFFF2E97" BlurRadius="10" ShadowDepth="0" Opacity="0.75"/>
                    </Button.Effect>
                </Button>

                <Button Style="{StaticResource Transport}" Tag="Next" Click="Transport" Content="&#xE893;"
                        IsEnabled="{Binding CanNext}" ToolTip="Next track" Margin="0,0,8,0"/>
                <Button Tag="Repeat" Click="Transport" Content="&#xE8EE;" IsEnabled="{Binding CanRepeat}"
                        ToolTip="{Binding RepeatHint}" AutomationProperties.Name="{Binding RepeatHint}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Transport}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Repeating}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
